[{"slug": "philadelphia-pa-property-tax-guide", "title": "Philadelphia, PA Property Tax Guide: Offices, Dates and Selling With Tax Due", "content": "<!-- wp:html -->\n<style>.wsp-hero{position:relative;margin:0 calc(-50vw + 50%);padding:5rem 1.5rem;background-image:none;background:linear-gradient(170deg,#12293f 0%,#0c1c2e 46%,#060c16 100%);overflow:hidden;}.wsp-hero-inner{max-width:1216px;margin:0 auto;display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem;align-items:center;}.wsp-hero-left{text-align:center;}.wsp-hero-left h1{color:#fff;font-size:2.6rem;font-weight:800;line-height:1.15;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left h2{color:#fff;font-weight:300;font-size:1.3rem;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left p{color:#fff;font-size:1rem;font-weight:300;max-width:500px;margin:0 auto 1.5rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-btn-outline{display:inline-flex;align-items:center;border:2px solid #fff;border-radius:30px;padding:.6rem 1.4rem;font-weight:600;color:#fff;text-decoration:none;font-size:.95rem;}.wsp-btn-outline:hover{background:#fff;color:#1A202C;}.wsp-hero-right iframe{width:100%;min-height:560px;border:none;border-radius:4px;}.wsp-wrap{max-width:900px;margin:0 auto;padding:3rem 1.5rem 4rem;}@media (max-width:900px){.wsp-hero-inner{grid-template-columns:1fr;}.wsp-hero-left h1{font-size:2.1rem;}}.wsp-wrap h3{background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #3182CE;border-radius:8px;padding:.9rem 1.25rem;margin:1.75rem 0 0;font-size:1.05rem;font-weight:700;color:#1A202C;}.wsp-wrap h3+p{background:#fff;border:1px solid #e2e8f0;border-top:none;border-radius:0 0 8px 8px;padding:1rem 1.25rem;margin:0 0 .25rem;color:#444;}.wsp-wrap table td{vertical-align:top;}.chb-cta p{margin:0}.wsp-related{margin:2.5rem 0 1rem}.wsp-related h2{font-size:1.3rem;margin-bottom:1rem;font-weight:600;}.wsp-related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}.wsp-related-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:1.1rem 1.25rem;}.wsp-related-card a{font-weight:700;color:var(--global-palette1, #3182CE);text-decoration:none;}.wsp-related-card a:hover{text-decoration:underline;}.wsp-related-card p{margin:.35rem 0 0;font-size:.9rem;color:#555;}.wsp-hero a.wsp-btn-call{background:#E0A83C !important;border:2px solid #E0A83C !important;color:#16203A !important;font-size:1.25rem !important;font-weight:800 !important;padding:1rem 2.2rem !important;border-radius:40px !important;box-shadow:0 0 0 4px rgba(224,168,60,.25),0 8px 26px rgba(224,168,60,.5) !important;text-shadow:none !important;}.wsp-hero a.wsp-btn-call strong{color:#16203A !important;}.wsp-hero a.wsp-btn-call:hover{background:#fff !important;border-color:#fff !important;}</style><div class='wsp-hero'><div class='wsp-hero-inner'><div class='wsp-hero-left'><h1>Philadelphia, PA Property Tax Guide: Offices, Dates and Selling With Tax Due</h1><div class=wsp-kicker>Cash Home Buyers in Pennsylvania</div><div class=wsp-speed><span>Cash Offer in 24 Hours</span></div><ul class=wsp-checks><li>Philadelphia, PA Property Tax Guide: inherited, behind on payments, tenants or repairs, we buy the house as-is</li><li>No fees, commissions or closing costs on a Philadelphia, PA Property Tax Guide sale</li><li>Turn the Philadelphia, PA Property Tax Guide offer down and you owe us nothing</li></ul><h2>Owe Philadelphia Property Tax? Get a Cash Offer</h2><p>We buy Philadelphia houses as-is.</p><p><a class='wsp-btn-outline wsp-btn-call' href='tel:424-435-2326'>Call or Text <strong>&nbsp;(424) 435-2326</strong></a></p></div><div class='wsp-hero-right'><iframe src='https://connect.cashhomebuyersca.com/widget/form/zKzKbSeB3aqwWwE8NNxO' data-form-id='zKzKbSeB3aqwWwE8NNxO' title='Cash Offer Form'></iframe><br /><script src='https://connect.cashhomebuyersca.com/js/form_embed.js' async></script></div></div></div><div class='wsp-wrap'><p><em>Last updated November 14, 2026.</em></p><p><strong>Philadelphia property tax is billed by the offices named below.</strong></p><h2>Who bills what in Philadelphia</h2><ul><li><a href='https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/real-estate-tax/' target='_blank' rel='noreferrer noopener nofollow'>Office of Property Assessment</a> handles assessment.</li><li><a href='https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/real-estate-tax/' target='_blank' rel='noreferrer noopener nofollow'>Philadelphia Department of Revenue</a> bills and collects the tax.</li></ul><h2>Due dates</h2><p>Real Estate Tax payments due March 31 each year; bills usually mailed in December; additions accrue 1.5%/month from April 1. See the <a href='https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/real-estate-tax/' target='_blank' rel='noreferrer noopener nofollow'>official page</a>.</p><h2>Challenging your assessment</h2><p>Appeal to Board of Revision of Taxes (BRT); must be filed by the first Monday in October of the year before the tax year (Oct 5, 2026 for tax year 2027 per BRT search excerpt). See the <a href='https://www.phila.gov/services/payments-assistance-taxes/appeal-a-property-assessment/' target='_blank' rel='noreferrer noopener nofollow'>official page</a>.</p><h2>Tax rate</h2><p>The official page we opened lists 1.3998% of assessed value (0.6159% City + 0.7839% School District) for 2025. See the <a href='https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/real-estate-tax/' target='_blank' rel='noreferrer noopener nofollow'>official page</a>.</p><h2>Local notes</h2><ul><li>City and county are coterminous; Philadelphia sub-est row is place-level only</li><li>Homestead exemption $80,000 (opened page)</li></ul><div class=\"chb-cta\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#fff;\"><div style=\"max-width:600px;\"><div style=\"font-size:12px;font-weight:800;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Behind on Philadelphia property tax?</div><div style=\"font-weight:800;font-size:20px;line-height:1.35;color:#fff;\">We buy Philadelphia houses as-is, and the title company pays unpaid tax from the proceeds.</div></div><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div><h2>Philadelphia by the numbers</h2><p>With about 1,582,432 residents, Philadelphia is number 1 of the 25 pa places in this guide by population (Census Bureau, 2019-2023). Census respondents put the median owner-occupied home in Philadelphia at $232,400, 23% above the pa median for these places. Renters live in about 48% of Philadelphia homes, and owners in 52%, where the pa median is 48% owners. A median build year of 1949 puts the typical Philadelphia house near 74 years old. These numbers describe Philadelphia as a whole, so a given street can sit well above or below them.</p><div class='wsp-related'><div class='wsp-related-grid'><div class='wsp-related-card'><a href='https://cashhomebuyersca.com/we-buy-houses-in-pennsylvania/'>We buy houses in Pennsylvania</a><p>How a cash offer works.</p></div><div class='wsp-related-card'><a href='https://cashhomebuyersca.com/sell-my-house-fast-philadelphia-pa/'>Sell my house in Philadelphia</a><p>Options and cash offers.</p></div><div class='wsp-related-card'><a href='https://cashhomebuyersca.com/pennsylvania-property-tax-guide/'>Pennsylvania property tax guide</a><p>Appeals, homestead and rebate.</p></div><div class='wsp-related-card'><a href='https://cashhomebuyersca.com/pennsylvania-inheritance-tax/'>Pennsylvania inheritance tax</a><p>Rates and the 3 month discount.</p></div></div></div><h2>Sources</h2><ul><li><a href='https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/real-estate-tax/' target='_blank' rel='noreferrer noopener nofollow'>Office of Property Assessment</a></li><li><a href='https://www.phila.gov/services/payments-assistance-taxes/taxes/property-and-real-estate-taxes/real-estate-tax/' target='_blank' rel='noreferrer noopener nofollow'>Philadelphia Department of Revenue</a></li><li><a href='https://www.pa.gov/agencies/revenue/resources/tax-types-and-information/realty-transfer-tax' target='_blank' rel='noreferrer noopener nofollow'>Pennsylvania Department of Revenue: Realty transfer tax</a></li><li><a href='https://www.palegis.us/statutes/consolidated' target='_blank' rel='noreferrer noopener nofollow'>Pennsylvania Consolidated Statutes</a></li></ul><p><em>This is general information about Philadelphia, not legal or tax advice. Confirm details with the official office or a licensed professional.</em></p><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://cashhomebuyersca.com/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Pennsylvania\", \"item\": \"https://cashhomebuyersca.com/we-buy-houses-in-pennsylvania/\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Philadelphia property tax guide\", \"item\": \"https://cashhomebuyersca.com/philadelphia-pa-property-tax-guide/\"}]}</script></div>\n<!-- /wp:html -->", "status": "publish", "rank_math_title": "Philadelphia, PA Property Tax Guide", "rank_math_description": "Philadelphia, PA property tax: assessor and collector offices, due dates, appeals and what happens to unpaid tax when you sell.", "rank_math_focus_keyword": "philadelphia property tax"}, {"slug": "pittsburgh-pa-property-tax-guide", "title": "Pittsburgh, PA Property Tax Guide: Offices, Dates and Selling With Tax Due", "content": "<!-- wp:html -->\n<style>.wsp-hero{position:relative;margin:0 calc(-50vw + 50%);padding:5rem 1.5rem;background-image:none;background:linear-gradient(170deg,#12293f 0%,#0c1c2e 46%,#060c16 100%);overflow:hidden;}.wsp-hero-inner{max-width:1216px;margin:0 auto;display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem;align-items:center;}.wsp-hero-left{text-align:center;}.wsp-hero-left h1{color:#fff;font-size:2.6rem;font-weight:800;line-height:1.15;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left h2{color:#fff;font-weight:300;font-size:1.3rem;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left p{color:#fff;font-size:1rem;font-weight:300;max-width:500px;margin:0 auto 1.5rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-btn-outline{display:inline-flex;align-items:center;border:2px solid #fff;border-radius:30px;padding:.6rem 1.4rem;font-weight:600;color:#fff;text-decoration:none;font-size:.95rem;}.wsp-btn-outline:hover{background:#fff;color:#1A202C;}.wsp-hero-right iframe{width:100%;min-height:560px;border:none;border-radius:4px;}.wsp-wrap{max-width:900px;margin:0 auto;padding:3rem 1.5rem 4rem;}@media (max-width:900px){.wsp-hero-inner{grid-template-columns:1fr;}.wsp-hero-left h1{font-size:2.1rem;}}.wsp-wrap h3{background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #3182CE;border-radius:8px;padding:.9rem 1.25rem;margin:1.75rem 0 0;font-size:1.05rem;font-weight:700;color:#1A202C;}.wsp-wrap h3+p{background:#fff;border:1px solid #e2e8f0;border-top:none;border-radius:0 0 8px 8px;padding:1rem 1.25rem;margin:0 0 .25rem;color:#444;}.wsp-wrap table td{vertical-align:top;}.chb-cta p{margin:0}.wsp-related{margin:2.5rem 0 1rem}.wsp-related h2{font-size:1.3rem;margin-bottom:1rem;font-weight:600;}.wsp-related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}.wsp-related-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:1.1rem 1.25rem;}.wsp-related-card a{font-weight:700;color:var(--global-palette1, #3182CE);text-decoration:none;}.wsp-related-card a:hover{text-decoration:underline;}.wsp-related-card p{margin:.35rem 0 0;font-size:.9rem;color:#555;}.wsp-hero a.wsp-btn-call{background:#E0A83C !important;border:2px solid #E0A83C !important;color:#16203A !important;font-size:1.25rem !important;font-weight:800 !important;padding:1rem 2.2rem !important;border-radius:40px !important;box-shadow:0 0 0 4px rgba(224,168,60,.25),0 8px 26px rgba(224,168,60,.5) !important;text-shadow:none !important;}.wsp-hero a.wsp-btn-call strong{color:#16203A !important;}.wsp-hero a.wsp-btn-call:hover{background:#fff !important;border-color:#fff !important;}</style><div class='wsp-hero'><div class='wsp-hero-inner'><div class='wsp-hero-left'><h1>Pittsburgh, PA Property Tax Guide: Offices, Dates and Selling With Tax Due</h1><div class=wsp-kicker>Cash Home Buyers in Pennsylvania</div><div class=wsp-speed><span>Cash Offer in 24 Hours</span></div><ul class=wsp-checks><li>Pittsburgh, PA Property Tax Guide: inherited, behind on payments, tenants or repairs, we buy the house as-is</li><li>No fees, commissions or closing costs on a Pittsburgh, PA Property Tax Guide sale</li><li>Turn the Pittsburgh, PA Property Tax Guide offer down and you owe us nothing</li></ul><h2>Owe Pittsburgh Property Tax? Get a Cash Offer</h2><p>We buy Pittsburgh houses as-is.</p><p><a class='wsp-btn-outline wsp-btn-call' href='tel:424-435-2326'>Call or Text <strong>&nbsp;(424) 435-2326</strong></a></p></div><div class='wsp-hero-right'><iframe src='https://connect.cashhomebuyersca.com/widget/form/zKzKbSeB3aqwWwE8NNxO' data-form-id='zKzKbSeB3aqwWwE8NNxO' title='Cash Offer Form'></iframe><br /><script src='https://connect.cashhomebuyersca.com/js/form_embed.js' async></script></div></div></div><div class='wsp-wrap'><p><em>Last updated November 14, 2026.</em></p><p><strong>Pittsburgh property tax is billed by the offices named below.</strong></p><h2>Who bills what in Pittsburgh</h2><ul><li><a href='https://www.pittsburghpa.gov/City-Government/Finance-Budget/Taxes/Real-Estate-Taxes' target='_blank' rel='noreferrer noopener nofollow'>Allegheny County Office of Property Assessments</a> handles assessment.</li><li><a href='https://www.pittsburghpa.gov/City-Government/Finance-Budget/Taxes/Real-Estate-Taxes' target='_blank' rel='noreferrer noopener nofollow'>City of Pittsburgh</a> bills and collects the tax.</li></ul><h2>Due dates</h2><p>2% discount if paid by Feb 10; Feb 27 (1st installment or gross annual); Apr 30 (2nd); Jul 31 (3rd). See the <a href='https://www.pittsburghpa.gov/City-Government/Finance-Budget/Taxes/Real-Estate-Taxes' target='_blank' rel='noreferrer noopener nofollow'>official page</a>.</p><h2>Challenging your assessment</h2><p>Appeals to Board of Property Assessment Appeals and Review (BPAAR). Opened page: &#x27;2027 Annual Appeal submission period was from July 1, 2026, through September 1, 2026&#x27; (annual window Jul 1-Sep 1 inferred, only the 2027 window stated). Page gave no filing URL.. See the <a href='https://www.alleghenycounty.us/Services/Property-Assessments-and-Real-Estate/Appeals/Board-of-Property-Assessment-Appeals-and-Review-BPAAR' target='_blank' rel='noreferrer noopener nofollow'>official page</a>.</p><h2>Tax rate</h2><p>We could not confirm the current Pittsburgh rate on an opened page, so we do not state one.</p><div class=\"chb-cta\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#fff;\"><div style=\"max-width:600px;\"><div style=\"font-size:12px;font-weight:800;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Behind on Pittsburgh property tax?</div><div style=\"font-weight:800;font-size:20px;line-height:1.35;color:#fff;\">We buy Pittsburgh houses as-is, and the title company pays unpaid tax from the proceeds.</div></div><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div><h2>Pittsburgh by the numbers</h2><p>Pittsburgh has roughly 303,620 residents in the Census Bureau's 2019-2023 survey, and ranks number 2 by population among the 25 pa places in this guide. Owner-occupied homes have a median value of $193,200 here, which is 2% above the middle figure for the 25 pa places. About 53% of households rent, so 47% own; the pa median for these places is 48% owner-occupied. Homes here were typically built in 1942, so the median house is about 81 years old. These numbers describe Pittsburgh as a whole, so a given street can sit well above or below them.</p><div class='wsp-related'><div class='wsp-related-grid'><div class='wsp-related-card'><a href='https://cashhomebuyersca.com/we-buy-houses-in-pennsylvania/'>We buy houses in Pennsylvania</a><p>How a cash offer works.</p></div><div class='wsp-related-card'><a href='https://cashhomebuyersca.com/sell-my-house-fast-pittsburgh-pa/'>Sell my house in Pittsburgh</a><p>Options and cash offers.</p></div><div class='wsp-related-card'><a href='https://cashhomebuyersca.com/pennsylvania-property-tax-guide/'>Pennsylvania property tax guide</a><p>Appeals, homestead and rebate.</p></div><div class='wsp-related-card'><a href='https://cashhomebuyersca.com/pennsylvania-inheritance-tax/'>Pennsylvania inheritance tax</a><p>Rates and the 3 month discount.</p></div></div></div><h2>Sources</h2><ul><li><a href='https://www.pittsburghpa.gov/City-Government/Finance-Budget/Taxes/Real-Estate-Taxes' target='_blank' rel='noreferrer noopener nofollow'>Allegheny County Office of Property Assessments</a></li><li><a href='https://www.pittsburghpa.gov/City-Government/Finance-Budget/Taxes/Real-Estate-Taxes' target='_blank' rel='noreferrer noopener nofollow'>City of Pittsburgh</a></li><li><a href='https://www.pa.gov/agencies/revenue/resources/tax-types-and-information/realty-transfer-tax' target='_blank' rel='noreferrer noopener nofollow'>Pennsylvania Department of Revenue: Realty transfer tax</a></li><li><a href='https://www.palegis.us/statutes/consolidated' target='_blank' rel='noreferrer noopener nofollow'>Pennsylvania Consolidated Statutes</a></li></ul><p><em>This is general information about Pittsburgh, not legal or tax advice. Confirm details with the official office or a licensed professional.</em></p><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://cashhomebuyersca.com/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Pennsylvania\", \"item\": \"https://cashhomebuyersca.com/we-buy-houses-in-pennsylvania/\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Pittsburgh property tax guide\", \"item\": \"https://cashhomebuyersca.com/pittsburgh-pa-property-tax-guide/\"}]}</script></div>\n<!-- /wp:html -->", "status": "publish", "rank_math_title": "Pittsburgh, PA Property Tax Guide", "rank_math_description": "Pittsburgh, PA property tax: assessor and collector offices, due dates, appeals and what happens to unpaid tax when you sell.", "rank_math_focus_keyword": "pittsburgh property tax"}]