[{"slug": "louisiana-guides-by-city-and-county", "title": "Louisiana Guides: Property Tax, Probate, Foreclosure and Selling by City and County", "content": "<!-- wp:html -->\n<style>.wsp-hero{position:relative;margin:0 calc(-50vw + 50%);padding:5rem 1.5rem;background-image:none;background:linear-gradient(170deg,#12293f 0%,#0c1c2e 46%,#060c16 100%);overflow:hidden;}.wsp-hero-inner{max-width:1216px;margin:0 auto;display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem;align-items:center;}.wsp-hero-left{text-align:center;}.wsp-hero-left h1{color:#fff;font-size:2.6rem;font-weight:800;line-height:1.15;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left h2{color:#fff;font-weight:300;font-size:1.3rem;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left p{color:#fff;font-size:1rem;font-weight:300;max-width:500px;margin:0 auto 1.5rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-btn-outline{display:inline-flex;align-items:center;border:2px solid #fff;border-radius:30px;padding:.6rem 1.4rem;font-weight:600;color:#fff;text-decoration:none;font-size:.95rem;}.wsp-btn-outline:hover{background:#fff;color:#1A202C;}.wsp-hero-right iframe{width:100%;min-height:560px;border:none;border-radius:4px;}.wsp-wrap{max-width:900px;margin:0 auto;padding:3rem 1.5rem 4rem;}@media (max-width:900px){.wsp-hero-inner{grid-template-columns:1fr;}.wsp-hero-left h1{font-size:2.1rem;}}.wsp-wrap h3{background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #3182CE;border-radius:8px;padding:.9rem 1.25rem;margin:1.75rem 0 0;font-size:1.05rem;font-weight:700;color:#1A202C;}.wsp-wrap h3+p{background:#fff;border:1px solid #e2e8f0;border-top:none;border-radius:0 0 8px 8px;padding:1rem 1.25rem;margin:0 0 .25rem;color:#444;}.wsp-wrap table td{vertical-align:top;}.chb-cta p{margin:0}.wsp-related{margin:2.5rem 0 1rem}.wsp-related h2{font-size:1.3rem;margin-bottom:1rem;font-weight:600;}.wsp-related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}.wsp-related-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:1.1rem 1.25rem;}.wsp-related-card a{font-weight:700;color:var(--global-palette1, #3182CE);text-decoration:none;}.wsp-related-card a:hover{text-decoration:underline;}.wsp-related-card p{margin:.35rem 0 0;font-size:.9rem;color:#555;}.wsp-hero a.wsp-btn-call{background:#E0A83C !important;border:2px solid #E0A83C !important;color:#16203A !important;font-size:1.25rem !important;font-weight:800 !important;padding:1rem 2.2rem !important;border-radius:40px !important;box-shadow:0 0 0 4px rgba(224,168,60,.25),0 8px 26px rgba(224,168,60,.5) !important;text-shadow:none !important;}.wsp-hero a.wsp-btn-call strong{color:#16203A !important;}.wsp-hero a.wsp-btn-call:hover{background:#fff !important;border-color:#fff !important;}</style><div class='wsp-hero'><div class='wsp-hero-inner'><div class='wsp-hero-left'><h1>Louisiana Guides: Property Tax, Probate, Foreclosure and Selling by City and County</h1><div class=wsp-kicker>Cash Home Buyers in Louisiana</div><div class=wsp-speed><span>Cash Offer in 24 Hours</span></div><ul class=wsp-checks><li>Louisiana Guides: inherited, behind on payments, tenants or repairs, we buy the house as-is</li><li>No fees, commissions or closing costs on a Louisiana Guides sale</li><li>Turn the Louisiana Guides offer down and you owe us nothing</li></ul><h2>Sell Your Louisiana House for Cash</h2><p>Tell us about your Louisiana house.</p><p><a class='wsp-btn-outline wsp-btn-call' href='tel:424-435-2326'>Call or Text <strong>&nbsp;(424) 435-2326</strong></a></p></div><div class='wsp-hero-right'><iframe src='https://connect.cashhomebuyersca.com/widget/form/zKzKbSeB3aqwWwE8NNxO' data-form-id='zKzKbSeB3aqwWwE8NNxO' title='Cash Offer Form'></iframe><br /><script src='https://connect.cashhomebuyersca.com/js/form_embed.js' async></script></div></div></div><div class='wsp-wrap'><p><em>Last updated November 14, 2026.</em></p><div class=\"wsp-related\"><h3>Statewide guides</h3><p><a href=\"https://cashhomebuyersca.com/orleans-parish-la-clerk-of-court/\">Orleans Parish, LA Clerk of Court Guide</a> <a href=\"https://cashhomebuyersca.com/terrebonne-parish-la-clerk-of-court/\">Terrebonne Parish, LA Clerk of Court Guide</a> <a href=\"https://cashhomebuyersca.com/jefferson-parish-la-clerk-of-court/\">Jefferson Parish, LA Clerk of Court Guide</a> <a href=\"https://cashhomebuyersca.com/lafayette-parish-la-clerk-of-court/\">Lafayette Parish, LA Clerk of Court Guide</a> <a href=\"https://cashhomebuyersca.com/livingston-parish-la-clerk-of-court/\">Livingston Parish, LA Clerk of Court Guide</a> <a href=\"https://cashhomebuyersca.com/ouachita-parish-la-clerk-of-court/\">Ouachita Parish, LA Clerk of Court Guide</a> <a href=\"https://cashhomebuyersca.com/washington-parish-la-clerk-of-court/\">Washington Parish, LA Clerk of Court Guide</a> <a href=\"https://cashhomebuyersca.com/louisiana-property-tax-guide/\">Louisiana Property Tax Guide: Appeals</a> <a href=\"https://cashhomebuyersca.com/louisiana-homestead-exemption/\">Louisiana Homestead Exemption Guide</a> <a href=\"https://cashhomebuyersca.com/louisiana-estate-tax/\">Louisiana Estate and Inheritance Tax</a> <a href=\"https://cashhomebuyersca.com/louisiana-eviction-process/\">Louisiana Eviction Process and Tenants</a> <a href=\"https://cashhomebuyersca.com/louisiana-quitclaim-deed/\">Louisiana Quitclaim Deed: Recording and Fees</a> <a href=\"https://cashhomebuyersca.com/louisiana-probate-process/\">Louisiana Probate Process Explained</a></p><h3>Sell my house by city</h3><p><a href=\"https://cashhomebuyersca.com/sell-my-house-fast-new-orleans-la/\">Sell My House Fast in New Orleans, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-baton-rouge-la/\">Sell My House Fast in Baton Rouge, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-shreveport-la/\">Sell My House Fast in Shreveport, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-lafayette-la/\">Sell My House Fast in Lafayette, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-lake-charles-la/\">Sell My House Fast in Lake Charles, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-st-george-la/\">Sell My House Fast in St. George, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-kenner-la/\">Sell My House Fast in Kenner, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-bossier-city-la/\">Sell My House Fast in Bossier City, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-monroe-la/\">Sell My House Fast in Monroe, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-alexandria-la/\">Sell My House Fast in Alexandria, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-houma-la/\">Sell My House Fast in Houma, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-central-la/\">Sell My House Fast in Central, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-slidell-la/\">Sell My House Fast in Slidell, LA</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-new-iberia-la/\">Sell My House Fast in New Iberia, LA</a></p><h3>Property tax guides by city</h3><p><a href=\"https://cashhomebuyersca.com/baton-rouge-la-property-tax-guide/\">Baton Rouge, LA Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/shreveport-la-property-tax-guide/\">Shreveport, LA Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/lafayette-la-property-tax-guide/\">Lafayette, LA Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/orleans-parish-la-property-tax-guide/\">Orleans Parish, LA Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/lafayette-parish-la-property-tax-guide/\">Lafayette Parish, LA Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/caddo-parish-la-property-tax-guide/\">Caddo Parish, LA Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/jefferson-parish-la-property-tax-guide/\">Jefferson Parish, LA Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/bossier-parish-la-property-tax-guide/\">Bossier Parish, LA Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/terrebonne-parish-la-property-tax-guide/\">Terrebonne Parish, LA Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/ouachita-parish-la-property-tax-guide/\">Ouachita Parish, LA Property Tax Guide</a></p></div>\n<div class=\"chb-cta\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#fff;\"><div style=\"max-width:600px;\"><div style=\"font-size:12px;font-weight:800;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Selling in Louisiana?</div><div style=\"font-weight:800;font-size:20px;line-height:1.35;color:#fff;\">We buy Louisiana houses as-is, with no commission, no repairs and no closing costs to you.</div></div><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div></div>\n<!-- /wp:html --<div class='chb-rw'><h2>How is Louisiana divided, and why does it matter to a home seller?</h2><p>Louisiana has 64 parishes where other states have counties, and almost every step of a house sale, from recording a deed to paying property tax, runs through the parish. The parish clerk of court, the parish assessor and the parish sheriff or tax collector are the offices a seller deals with.</p><p>Wikipedia's list of parishes notes that 38 parishes are governed by a police jury and the other 26 use other forms, including council-president, council-manager, parish commission and consolidated parish and city governments. The state overview adds that Louisiana has 308 incorporated municipalities, four of them consolidated city-parishes. Orleans Parish has the same boundaries as the City of New Orleans, so a New Orleans seller is also dealing with the parish.</p><p>The state's total area is 52,271 square miles, about 15 percent of it water, and the 2020 census counted 4,657,757 residents. A 2025 estimate of 4,618,189 is about 0.8 percent lower than the 2020 count.</p><h2>Which parts of the state have the most people?</h2><p>The population sits mostly in Greater New Orleans, the Florida Parishes and Acadiana, while Central and North Louisiana have been losing residents. The table lists the eight largest parishes as shown on Wikipedia's parish list, which does not label the year of the figures.</p><table><thead><tr><th>Parish</th><th>Parish seat</th><th>Population shown</th></tr></thead><tbody><tr><td>East Baton Rouge</td><td>Baton Rouge</td><td>456,180</td></tr><tr><td>Jefferson</td><td>Gretna</td><td>431,398</td></tr><tr><td>Orleans</td><td>New Orleans</td><td>362,154</td></tr><tr><td>St. Tammany</td><td>Covington</td><td>279,108</td></tr><tr><td>Lafayette</td><td>Lafayette</td><td>257,949</td></tr><tr><td>Caddo</td><td>Shreveport</td><td>224,226</td></tr><tr><td>Calcasieu</td><td>Lake Charles</td><td>208,466</td></tr><tr><td>Ouachita</td><td>Monroe</td><td>158,542</td></tr></tbody></table><p>The smallest is Tensas Parish at 3,700 residents. Calcasieu and Cameron parishes in Southwest Louisiana each lost more than 5 percent of their population after 2020.</p><h2>What are the main regions, and how do they differ?</h2><p>The state is usually described as North Louisiana (the uplands) plus an alluvial coastal region that includes Central Louisiana, Acadiana, the Florida Parishes and Greater New Orleans. Each region has its own housing stock and weather exposure.</p><ul><li>North Louisiana covers Shreveport and Bossier City on the Red River, and Monroe on the Ouachita River.</li><li>Acadiana in the southwest was settled largely by Acadians in 1765, and Lafayette is one of the metro areas the state overview names.</li><li>The Florida Parishes lie north and east of the Mississippi River, with Slidell among the metro areas the state overview names.</li><li>Greater New Orleans includes the state's lowest point: New Orleans itself, at minus 8.2 feet.</li></ul><p>Average elevation is 98 feet, and the highest point is Driskill Mountain at 535 feet. Coastal and swamp land sits around 10 feet, while prairie and alluvial land reaches 50 to 60 feet.</p><div class=\"chb-cta chb-cta-x\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:24px 28px;color:#fff;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;\"><span style=\"display:block;max-width:600px;font-weight:800;font-size:19px;line-height:1.35;color:#fff;\"><span style=\"display:block;font-size:12px;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Free, no-obligation offer</span>Tell us about your Louisiana house and get a written cash offer within 24 hours.</span><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div></div><h2>How do hurricanes and flooding affect house sales here?</h2><p>Louisiana has a humid subtropical climate, and storms shape both repair costs and buyer caution. The state overview says hurricanes are a major risk, especially around New Orleans, and that Hurricane Katrina in 2005 flooded more than 80 percent of the city.</p><p>An August 2016 storm caused catastrophic flooding in southern Louisiana, including Baton Rouge and Lafayette. The state also averages more than 60 thunderstorm days and about 27 tornadoes a year, and it lost 1,800 square miles of coastal land between 1932 and 2010.</p><p>For sellers, the practical result is a house history that often includes insurance claims, gut repairs or elevated foundations. A buyer who purchases as-is can take on that history, which is part of why owners of storm-damaged houses sometimes look at cash sales. The homestead exemption has a disaster rule too, covered on our homestead exemption page.</p><h2>Where does a deed get recorded, and what does it cost?</h2><p>A deed goes to the parish clerk of court, who acts as ex officio recorder of mortgages and conveyances. The legal reason is in Civil Code art. 3338: a written instrument that transfers an immovable or creates a real right in it has no effect as to third persons until it is recorded.</p><p>The fee schedule is in <a href='https://www.legis.la.gov/legis/Law.aspx?d=78106'>R.S. 13:844</a>, and it depends on page count: $100 for one to five pages, $200 for six to 25, $300 for 26 to 50, and $300 plus $5 per extra page above 50. Indexing of up to ten names is included. A document recorded in both the mortgage and conveyance records is charged for each.</p><p>The <a href='https://orleanscivilclerk.com/images/LandRecordsFeeSheetHonChelseyRichardNapoleon.pdf'>Orleans Parish clerk's land records fee sheet</a>, updated August 21, 2026, repeats those recording tiers and adds local items such as a $5 portal fee per recording and a $30 building fund fee. Other parishes may add their own charges, so call the clerk before closing.</p><p>The Louisiana Clerks' Remote Access Authority, created in 2014, runs a statewide portal called eClerksLA that gives remote access to records held by participating parish clerks.</p><h2>What must a Louisiana deed say about property taxes?</h2><p>Under <a href='https://law.justia.com/codes/louisiana/revised-statutes/title-9/rs-9-2721/'>R.S. 9:2721(A)</a>, a conveyance of immovable property filed with the parish recorder must name the person responsible for all property taxes and assessments and give a mailing address for tax notices. That person has to give the information to the assessor of the parish where the property is located.</p><p>Subsection B adds a rule that matters for buyers and sellers of rentals. Whoever acquires an immovable takes it subject to a recorded lease that the acquisition does not cancel.</p><div class=\"chb-cta chb-cta-x\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:24px 28px;color:#fff;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;\"><span style=\"display:block;max-width:600px;font-weight:800;font-size:19px;line-height:1.35;color:#fff;\"><span style=\"display:block;font-size:12px;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Sell as-is</span>No repairs, no cleaning and no showings. We buy Louisiana houses in any condition.</span><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">See My Cash Offer &rarr;</a></div></div><h2>How is property tax run in Louisiana?</h2><p>Each of the 64 parishes has one elected assessor, and the assessor values real property in the parish and calculates the tax owed. The Legislative Auditor's guide says assessors must reappraise all taxable property at least every four years, as the constitution requires, and submit the annual tax roll to the Louisiana Tax Commission.</p><ul><li>Land and residential improvements are assessed at 10 percent of fair market value under Article VII, section 18.</li><li>Public service property is valued by the Louisiana Tax Commission instead of the parish assessor.</li><li>Assessments are reviewed first by the parish governing authority, then by the Tax Commission, then the courts.</li><li>The homestead exemption takes $7,500 off assessed value of an owner-occupied home, and separate age and veteran programs exist, as our homestead exemption guide explains.</li></ul><p>The Louisiana Tax Commission was established by R.S. 47:1831 as a state agency continuing a commission created in 1916.</p><h2>What does the assessment appeal calendar look like in the largest parish?</h2><p>In Orleans Parish, the City Council's own page lists a short calendar. The assessor opens the tax lists for public inspection from July 15 to August 17, 2026, and a formal appeal had to be filed with the assessor by August 20, 2026. Board of Review hearings ran September 15 to 25, 2026.</p><p>After that, written determinations were to be mailed the week of October 19, 2026, and a taxpayer may appeal in writing to the Louisiana Tax Commission within 10 business days of notice. The council's page also says the Board of Review cannot rule on homestead exemption denials, age freezes or disability determinations, which stay with the assessor. The page flags inconsistent dates between its summary and its FAQ, so confirm with the assessor.</p><p>Other parishes publish their own roll inspection dates, and a 2014 summary from the Louisiana House Fiscal Division describes a 15-day window between August 15 and September 15 in most parishes. Treat that as old background, not the current calendar.</p><h2>What happens when property taxes go unpaid?</h2><p>Louisiana sells the tax lien, and the owner has a redemption period before ownership changes. The Loyola desk manual cites Article VII, section 25 and R.S. 47:2121 and following, and says the redemption period is three years from recording of the tax sale certificate, or 18 months for blighted property.</p><p>Redemption costs the delinquent taxes, accrued taxes, costs, a 5 percent penalty and simple interest of 1 percent per month. A homeowner behind on taxes who wants to sell should check the parish tax collector's records for a recorded certificate before talking price with any buyer.</p><div class=\"chb-cta chb-cta-x\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:24px 28px;color:#fff;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;\"><span style=\"display:block;max-width:600px;font-weight:800;font-size:19px;line-height:1.35;color:#fff;\"><span style=\"display:block;font-size:12px;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">You pick the closing date</span>Close in as little as 7 days or on the date that works for you, with no fees or commissions.</span><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div></div><h2>What kinds of local guides do sellers usually need?</h2><p>Most Louisiana sellers need one of four things, and our parish and city pages follow them.</p><ul><li>Property tax and homestead questions for owners, which depend on the parish assessor.</li><li>Succession and affidavit questions for heirs, which depend on the parish court and clerk.</li><li>Tenant and lease questions for landlords, which depend on whether the lease was recorded.</li><li>Recording and fee questions at closing, which depend on the parish clerk.</li></ul><p>Because the parish decides so much, a statewide rule on this directory page is a starting point only. Use the parish page for the number, name and office that apply to your house.</p></div><h2>More questions about Louisiana Guides</h2><h3 class=\"wp-block-heading\">How many parishes does Louisiana have?</h3><p>Sixty-four. Louisiana uses parishes instead of counties, and each parish has its own clerk of court and its own elected assessor.</p><h3 class=\"wp-block-heading\">Where do I record a deed in Louisiana?</h3><p>With the clerk of court of the parish where the property is located. The clerk acts as the ex officio recorder, and recording is what makes the transfer effective against third persons under Civil Code art. 3338.</p><h3 class=\"wp-block-heading\">Who sets my Louisiana property tax assessment?</h3><p>The elected parish assessor values the property, usually at 10 percent of fair market value for land and a home. Disagreements go first to the parish governing authority, then to the Louisiana Tax Commission.</p><h3 class=\"wp-block-heading\">How long do I have to redeem a house after a Louisiana tax sale?</h3><p>Three years from recording of the tax sale certificate, or 18 months if the property is blighted, according to the Loyola desk manual's summary of Article VII, section 25.</p><h3 class=\"wp-block-heading\">Is there a statewide online records search?</h3><p>Yes, in part. The Louisiana Clerks' Remote Access Authority runs eClerksLA for records of participating parish clerks. Not every record in every parish is guaranteed to be on it.</p><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"How many parishes does Louisiana have?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Sixty-four. Louisiana uses parishes instead of counties, and each parish has its own clerk of court and its own elected assessor.\"}}, {\"@type\": \"Question\", \"name\": \"Where do I record a deed in Louisiana?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"With the clerk of court of the parish where the property is located. The clerk acts as the ex officio recorder, and recording is what makes the transfer effective against third persons under Civil Code art. 3338.\"}}, {\"@type\": \"Question\", \"name\": \"Who sets my Louisiana property tax assessment?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The elected parish assessor values the property, usually at 10 percent of fair market value for land and a home. Disagreements go first to the parish governing authority, then to the Louisiana Tax Commission.\"}}, {\"@type\": \"Question\", \"name\": \"How long do I have to redeem a house after a Louisiana tax sale?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Three years from recording of the tax sale certificate, or 18 months if the property is blighted, according to the Loyola desk manual's summary of Article VII, section 25.\"}}, {\"@type\": \"Question\", \"name\": \"Is there a statewide online records search?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Yes, in part. The Louisiana Clerks' Remote Access Authority runs eClerksLA for records of participating parish clerks. Not every record in every parish is guaranteed to be on it.\"}}]}</script>>", "status": "publish", "rank_math_title": "Louisiana Guides by City and County | Cash Home Buyers", "rank_math_description": "Every Louisiana guide in one place: property tax, probate, foreclosure and selling a house, by statewide topic, city and county. Official sources.", "rank_math_focus_keyword": "louisiana property guides"}]