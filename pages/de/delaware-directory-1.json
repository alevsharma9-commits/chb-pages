[{"slug": "delaware-guides-by-city-and-county", "title": "Delaware Guides: Property Tax, Probate, Foreclosure and Selling by City and County", "content": "<!-- wp:html -->\n<style>.wsp-hero{position:relative;margin:0 calc(-50vw + 50%);padding:5rem 1.5rem;background-image:none;background:linear-gradient(170deg,#12293f 0%,#0c1c2e 46%,#060c16 100%);overflow:hidden;}.wsp-hero-inner{max-width:1216px;margin:0 auto;display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem;align-items:center;}.wsp-hero-left{text-align:center;}.wsp-hero-left h1{color:#fff;font-size:2.6rem;font-weight:800;line-height:1.15;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left h2{color:#fff;font-weight:300;font-size:1.3rem;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left p{color:#fff;font-size:1rem;font-weight:300;max-width:500px;margin:0 auto 1.5rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-btn-outline{display:inline-flex;align-items:center;border:2px solid #fff;border-radius:30px;padding:.6rem 1.4rem;font-weight:600;color:#fff;text-decoration:none;font-size:.95rem;}.wsp-btn-outline:hover{background:#fff;color:#1A202C;}.wsp-hero-right iframe{width:100%;min-height:560px;border:none;border-radius:4px;}.wsp-wrap{max-width:900px;margin:0 auto;padding:3rem 1.5rem 4rem;}@media (max-width:900px){.wsp-hero-inner{grid-template-columns:1fr;}.wsp-hero-left h1{font-size:2.1rem;}}.wsp-wrap h3{background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #3182CE;border-radius:8px;padding:.9rem 1.25rem;margin:1.75rem 0 0;font-size:1.05rem;font-weight:700;color:#1A202C;}.wsp-wrap h3+p{background:#fff;border:1px solid #e2e8f0;border-top:none;border-radius:0 0 8px 8px;padding:1rem 1.25rem;margin:0 0 .25rem;color:#444;}.wsp-wrap table td{vertical-align:top;}.chb-cta p{margin:0}.wsp-related{margin:2.5rem 0 1rem}.wsp-related h2{font-size:1.3rem;margin-bottom:1rem;font-weight:600;}.wsp-related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}.wsp-related-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:1.1rem 1.25rem;}.wsp-related-card a{font-weight:700;color:var(--global-palette1, #3182CE);text-decoration:none;}.wsp-related-card a:hover{text-decoration:underline;}.wsp-related-card p{margin:.35rem 0 0;font-size:.9rem;color:#555;}.wsp-hero a.wsp-btn-call{background:#E0A83C !important;border:2px solid #E0A83C !important;color:#16203A !important;font-size:1.25rem !important;font-weight:800 !important;padding:1rem 2.2rem !important;border-radius:40px !important;box-shadow:0 0 0 4px rgba(224,168,60,.25),0 8px 26px rgba(224,168,60,.5) !important;text-shadow:none !important;}.wsp-hero a.wsp-btn-call strong{color:#16203A !important;}.wsp-hero a.wsp-btn-call:hover{background:#fff !important;border-color:#fff !important;}</style><div class='wsp-hero'><div class='wsp-hero-inner'><div class='wsp-hero-left'><h1>Delaware Guides: Property Tax, Probate, Foreclosure and Selling by City and County</h1><div class=wsp-kicker>Cash Home Buyers in Delaware</div><div class=wsp-speed><span>Cash Offer in 24 Hours</span></div><ul class=wsp-checks><li>Delaware Guides: inherited, behind on payments, tenants or repairs, we buy the house as-is</li><li>No fees, commissions or closing costs on a Delaware Guides sale</li><li>Turn the Delaware Guides offer down and you owe us nothing</li></ul><h2>Sell Your Delaware House for Cash</h2><p>Tell us about your Delaware house.</p><p><a class='wsp-btn-outline wsp-btn-call' href='tel:424-435-2326'>Call or Text <strong>&nbsp;(424) 435-2326</strong></a></p></div><div class='wsp-hero-right'><iframe src='https://connect.cashhomebuyersca.com/widget/form/zKzKbSeB3aqwWwE8NNxO' data-form-id='zKzKbSeB3aqwWwE8NNxO' title='Cash Offer Form'></iframe><br /><script src='https://connect.cashhomebuyersca.com/js/form_embed.js' async></script></div></div></div><div class='wsp-wrap'><p><em>Last updated November 14, 2026.</em></p><div class=\"wsp-related\"><h3>Statewide guides</h3><p><a href=\"https://cashhomebuyersca.com/delaware-property-tax-guide/\">Delaware Property Tax Guide: Appeals</a> <a href=\"https://cashhomebuyersca.com/delaware-estate-tax/\">Delaware Estate and Inheritance Tax</a> <a href=\"https://cashhomebuyersca.com/delaware-sheriff-sale/\">Delaware Sheriff Sale Explained</a> <a href=\"https://cashhomebuyersca.com/delaware-recording-deeds/\">Delaware Recording a Deed Guide</a></p><h3>Sell my house by city</h3><p><a href=\"https://cashhomebuyersca.com/sell-my-house-fast-wilmington-de/\">Sell My House Fast in Wilmington, DE</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-dover-de/\">Sell My House Fast in Dover, DE</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-newark-de/\">Sell My House Fast in Newark, DE</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-middletown-de/\">Sell My House Fast in Middletown, DE</a></p></div>\n<div class=\"chb-cta\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#fff;\"><div style=\"max-width:600px;\"><div style=\"font-size:12px;font-weight:800;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Selling in Delaware?</div><div style=\"font-weight:800;font-size:20px;line-height:1.35;color:#fff;\">We buy Delaware houses as-is, with no commission, no repairs and no closing costs to you.</div></div><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div></div>\n<!-- /wp:html --<div class='chb-rw'><h2>How is Delaware laid out for a home seller?</h2><p>Delaware is a small state with three counties, and each one runs its own tax office, recorder and assessment process. From north to south they are New Castle, Kent and Sussex, so the first question for any seller is which county the house sits in.</p><p>According to Wikipedia, Dover is the capital and Wilmington is the largest city. The northern tip sits on the Piedmont Plateau, with hills and rolling surfaces. The Atlantic Seaboard fall line roughly follows the Robert Kirkwood Highway between Newark and Wilmington, and south of it lies the flat, sandy and in places swampy Atlantic Coastal Plain. Delaware was the first state to ratify the Constitution, on December 7, 1787.</p><p>For a seller, the geography decides the paperwork more than the terrain does. The county holds the deed, the tax account and the assessment, and a house on the coastal plain is billed by a different office than a house on the Piedmont. A buyer who pays cash and takes the house as-is does not need the seller to make repairs, but the owner still has to know what the county will want at closing.</p><h2>What does the Delaware economy mean for sellers?</h2><p>Delaware's economy leans on corporate law, finance, chemicals and science, farming and beach tourism. Wikipedia says over half of New York Stock Exchange-listed corporations and over three-fifths of the Fortune 500 are legally incorporated in the state.</p><ul><li>Banking names include Bank of America, M&amp;T Bank, JPMorgan Chase, Citigroup and Deutsche Bank.</li><li>Chemical, pharmaceutical and technology employers include DuPont de Nemours, AstraZeneca, Syngenta and Agilent Technologies.</li><li>Agricultural output consists of poultry, nursery stock, soybeans, dairy products and corn.</li><li>Delaware's beaches generate $6.9 billion annually and over $711 million in tax revenue, according to SeaGrant Delaware as quoted on Wikipedia.</li></ul><p>Tourism alone generated $3.1 billion in 2015, which Wikipedia says made up five percent of the state's GDP. We do not publish price figures for any town on this page.</p><h2>What do the Census numbers say about Delaware housing?</h2><p>Delaware has just over one million residents and about 402,000 households. Nearly three in four households own their homes.</p><table><thead><tr><th>Measure</th><th>Delaware</th></tr></thead><tbody><tr><td>Population estimate, July 1, 2025</td><td>1,059,952</td></tr><tr><td>Population change, April 2020 to July 2025</td><td>7.1%</td></tr><tr><td>Households, 2020 to 2024</td><td>402,038</td></tr><tr><td>Persons per household, 2020 to 2024</td><td>2.48</td></tr><tr><td>Median household income, 2020 to 2024</td><td>$84,954</td></tr><tr><td>Mean travel time to work</td><td>26.0 minutes</td></tr><tr><td>Land area</td><td>1,948.55 square miles</td></tr><tr><td>Building permits, 2025</td><td>6,468</td></tr></tbody></table><p>Source: U.S. Census Bureau QuickFacts. The Census Bureau also reports a population density of 508 people per square mile for 2020, and 22.8% of residents are 65 or older.</p><p>The same table puts the median value of owner-occupied housing units at $352,000 for 2020 to 2024. Median selected monthly owner costs are $1,816 with a mortgage and $562 without one. Those are statewide medians and say nothing about any single house or town.</p><div class=\"chb-cta chb-cta-x\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:24px 28px;color:#fff;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;\"><span style=\"display:block;max-width:600px;font-weight:800;font-size:19px;line-height:1.35;color:#fff;\"><span style=\"display:block;font-size:12px;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Free, no-obligation offer</span>Tell us about your Delaware house and get a written cash offer within 24 hours.</span><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div></div><h2>How does Delaware property tax work across the three counties?</h2><p>Each county assesses, levies and collects its own property tax, and the dates differ. The statutes are in Title 9 of the Delaware Code.</p><table><thead><tr><th>County</th><th>Assessment roll open by</th><th>County tax levied by</th><th>Tax due</th><th>Collecting authority</th></tr></thead><tbody><tr><td>New Castle</td><td>March 1</td><td>June 1</td><td>July 1</td><td>Chief Financial Officer</td></tr><tr><td>Kent</td><td>April 1</td><td>June 30</td><td>June 1</td><td>Receiver of Taxes and County Treasurer</td></tr><tr><td>Sussex</td><td>February 15</td><td>July 1</td><td>July 1</td><td>Director of Finance</td></tr></tbody></table><p>The assessment dates are from 9 Del. C. Chapter 83, the levy dates from Chapter 80 and the due dates and collecting authorities from Chapter 86. Counties mail the bill within 30 days after taxes are due, and the statute says a missed bill does not excuse late payment.</p><p>A lien matters at sale. Under Chapter 87, county taxes continue as a lien for 10 years from July 1 of the levy year, and longer if the same owner still holds the property. In Kent and Sussex the statute says the lien has priority over all other liens.</p><h2>How do I challenge a Delaware assessment?</h2><p>Start with the county. In Sussex County, the Board of Assessment Review hears appeals from March 1 through May 31, or until all appeals are heard in a reassessment year, and appointments are made through the county Assessment Division.</p><p>The Board decides whether the assessment is correct after hearing the owner. If it finds an error, it orders the Director of Finance to correct it. New Castle and Kent have their own boards and schedules, so check the county's assessment office for current dates before you plan around a deadline.</p><p>The Board also reviews the methods the Director of Finance used to set assessments and can recommend improvements to the County Administrator. An owner who plans to sell should ask for a copy of the current assessment before the contract is signed, so any dispute is on the record.</p><h2>What does Delaware's realty transfer tax cost, and who pays?</h2><p>The combined realty transfer tax is 4% of value, made up of 2.5% for the state and 1.5% for the county or municipality. The Division of Revenue's instructions say the tax is split equally between grantor and grantee.</p><p>The statute is more detailed. Under 30 Del. C. 5402 the state rate is 3% unless the local government has enacted the full 1.5%, in which case it is 2.5%. A first-time home buyer's share can be reduced by one-half percent of the lesser of the value or $400,000. Section 5412 puts the burden on the grantor in the absence of a contrary agreement, and section 5404 gives the tax priority out of the proceeds of a judicial sale.</p><ul><li>Proof of payment must appear on the document before a Recorder of Deeds can record it (section 5408).</li><li>Every document must state the true, full value, or come with an affidavit explaining why it is exempt (section 5409).</li><li>A conveyance to a lender with a genuinely defaulted mortgage, by sheriff's sale or deed in lieu, is excluded (section 5401(1)p).</li><li>Transfers between spouses, parent and child, siblings, and grandparent and grandchild are excluded.</li></ul><div class=\"chb-cta chb-cta-x\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:24px 28px;color:#fff;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;\"><span style=\"display:block;max-width:600px;font-weight:800;font-size:19px;line-height:1.35;color:#fff;\"><span style=\"display:block;font-size:12px;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Sell as-is</span>No repairs, no cleaning and no showings. We buy Delaware houses in any condition.</span><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">See My Cash Offer &rarr;</a></div></div><h2>What other Delaware rules affect a sale?</h2><p>The state has no estate or inheritance tax for deaths after 2017, which is covered on our estate tax page, and it has a code for residential rentals. The code requires 60 days' written notice to end a month-to-month tenancy and sends eviction cases to the Justice of the Peace Court in the county.</p><p>A few practical points follow for sellers in any county:</p><ul><li>Find out which county office holds the deed, the tax account and any open estate file.</li><li>Ask the county for the current balance, including penalties, before you sign a contract.</li><li>Collect the lease, rent roll and any notices if tenants live in the house.</li><li>Have a title company or attorney confirm what must be recorded.</li></ul><p>We buy Delaware houses for cash in any of the three counties, as-is. Local city and county guides on this site go into the details of each place, and nothing here replaces advice from a Delaware attorney or tax professional.</p></div><h2>More questions about Delaware Guides</h2><h3 class=\"wp-block-heading\">How many counties does Delaware have?</h3><p>Three: New Castle, Kent and Sussex. Each one assesses and collects its own property tax and has its own recorder of deeds.</p><h3 class=\"wp-block-heading\">What is the realty transfer tax in Delaware?</h3><p>The combined rate is 4% of value, with 2.5% going to the state and 1.5% to the county or municipality. It is apportioned equally between buyer and seller, and the grantor bears it by default if the parties do not agree otherwise.</p><h3 class=\"wp-block-heading\">When are Delaware property taxes due?</h3><p>In New Castle and Sussex Counties, July 1. In Kent County, June 1. Bills are mailed within 30 days after the due date, and not receiving one does not excuse payment.</p><h3 class=\"wp-block-heading\">Is there a Delaware estate tax?</h3><p>No, not for people who died after December 31, 2017. The estate tax was repealed for those deaths, and the old inheritance tax was repealed effective January 1, 1999.</p><h3 class=\"wp-block-heading\">Where do I record a Delaware deed?</h3><p>With the Recorder of Deeds in the county where the property sits. Proof that realty transfer tax was paid has to appear on the document or an exemption affidavit must accompany it.</p><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"How many counties does Delaware have?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Three: New Castle, Kent and Sussex. Each one assesses and collects its own property tax and has its own recorder of deeds.\"}}, {\"@type\": \"Question\", \"name\": \"What is the realty transfer tax in Delaware?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The combined rate is 4% of value, with 2.5% going to the state and 1.5% to the county or municipality. It is apportioned equally between buyer and seller, and the grantor bears it by default if the parties do not agree otherwise.\"}}, {\"@type\": \"Question\", \"name\": \"When are Delaware property taxes due?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"In New Castle and Sussex Counties, July 1. In Kent County, June 1. Bills are mailed within 30 days after the due date, and not receiving one does not excuse payment.\"}}, {\"@type\": \"Question\", \"name\": \"Is there a Delaware estate tax?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"No, not for people who died after December 31, 2017. The estate tax was repealed for those deaths, and the old inheritance tax was repealed effective January 1, 1999.\"}}, {\"@type\": \"Question\", \"name\": \"Where do I record a Delaware deed?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"With the Recorder of Deeds in the county where the property sits. Proof that realty transfer tax was paid has to appear on the document or an exemption affidavit must accompany it.\"}}]}</script>>", "status": "publish", "rank_math_title": "Delaware Guides by City and County | Cash Home Buyers", "rank_math_description": "Every Delaware guide in one place: property tax, probate, foreclosure and selling a house, by statewide topic, city and county. Official sources.", "rank_math_focus_keyword": "delaware property guides"}]