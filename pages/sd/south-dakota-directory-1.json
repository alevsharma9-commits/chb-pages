[{"slug": "south-dakota-guides-by-city-and-county", "title": "South Dakota Guides: Property Tax, Probate, Foreclosure and Selling by City and County", "content": "<!-- wp:html -->\n<style>.wsp-hero{position:relative;margin:0 calc(-50vw + 50%);padding:5rem 1.5rem;background-image:none;background:linear-gradient(170deg,#12293f 0%,#0c1c2e 46%,#060c16 100%);overflow:hidden;}.wsp-hero-inner{max-width:1216px;margin:0 auto;display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem;align-items:center;}.wsp-hero-left{text-align:center;}.wsp-hero-left h1{color:#fff;font-size:2.6rem;font-weight:800;line-height:1.15;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left h2{color:#fff;font-weight:300;font-size:1.3rem;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left p{color:#fff;font-size:1rem;font-weight:300;max-width:500px;margin:0 auto 1.5rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-btn-outline{display:inline-flex;align-items:center;border:2px solid #fff;border-radius:30px;padding:.6rem 1.4rem;font-weight:600;color:#fff;text-decoration:none;font-size:.95rem;}.wsp-btn-outline:hover{background:#fff;color:#1A202C;}.wsp-hero-right iframe{width:100%;min-height:560px;border:none;border-radius:4px;}.wsp-wrap{max-width:900px;margin:0 auto;padding:3rem 1.5rem 4rem;}@media (max-width:900px){.wsp-hero-inner{grid-template-columns:1fr;}.wsp-hero-left h1{font-size:2.1rem;}}.wsp-wrap h3{background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #3182CE;border-radius:8px;padding:.9rem 1.25rem;margin:1.75rem 0 0;font-size:1.05rem;font-weight:700;color:#1A202C;}.wsp-wrap h3+p{background:#fff;border:1px solid #e2e8f0;border-top:none;border-radius:0 0 8px 8px;padding:1rem 1.25rem;margin:0 0 .25rem;color:#444;}.wsp-wrap table td{vertical-align:top;}.chb-cta p{margin:0}.wsp-related{margin:2.5rem 0 1rem}.wsp-related h2{font-size:1.3rem;margin-bottom:1rem;font-weight:600;}.wsp-related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}.wsp-related-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:1.1rem 1.25rem;}.wsp-related-card a{font-weight:700;color:var(--global-palette1, #3182CE);text-decoration:none;}.wsp-related-card a:hover{text-decoration:underline;}.wsp-related-card p{margin:.35rem 0 0;font-size:.9rem;color:#555;}.wsp-hero a.wsp-btn-call{background:#E0A83C !important;border:2px solid #E0A83C !important;color:#16203A !important;font-size:1.25rem !important;font-weight:800 !important;padding:1rem 2.2rem !important;border-radius:40px !important;box-shadow:0 0 0 4px rgba(224,168,60,.25),0 8px 26px rgba(224,168,60,.5) !important;text-shadow:none !important;}.wsp-hero a.wsp-btn-call strong{color:#16203A !important;}.wsp-hero a.wsp-btn-call:hover{background:#fff !important;border-color:#fff !important;}</style><div class='wsp-hero'><div class='wsp-hero-inner'><div class='wsp-hero-left'><h1>South Dakota Guides: Property Tax, Probate, Foreclosure and Selling by City and County</h1><div class=wsp-kicker>Cash Home Buyers in South Dakota</div><div class=wsp-speed><span>Cash Offer in 24 Hours</span></div><ul class=wsp-checks><li>South Dakota Guides: inherited, behind on payments, tenants or repairs, we buy the house as-is</li><li>No fees, commissions or closing costs on a South Dakota Guides sale</li><li>Turn the South Dakota Guides offer down and you owe us nothing</li></ul><h2>Sell Your South Dakota House for Cash</h2><p>Tell us about your South Dakota house.</p><p><a class='wsp-btn-outline wsp-btn-call' href='tel:424-435-2326'>Call or Text <strong>&nbsp;(424) 435-2326</strong></a></p></div><div class='wsp-hero-right'><iframe src='https://connect.cashhomebuyersca.com/widget/form/zKzKbSeB3aqwWwE8NNxO' data-form-id='zKzKbSeB3aqwWwE8NNxO' title='Cash Offer Form'></iframe><br /><script src='https://connect.cashhomebuyersca.com/js/form_embed.js' async></script></div></div></div><div class='wsp-wrap'><p><em>Last updated November 14, 2026.</em></p><div class=\"wsp-related\"><h3>Statewide guides</h3><p><a href=\"https://cashhomebuyersca.com/south-dakota-property-tax-guide/\">South Dakota Property Tax Guide: Appeals</a> <a href=\"https://cashhomebuyersca.com/south-dakota-probate-process/\">South Dakota Probate Process Explained</a></p><h3>Sell my house by city</h3><p><a href=\"https://cashhomebuyersca.com/sell-my-house-fast-sioux-falls-sd/\">Sell My House Fast in Sioux Falls, SD</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-rapid-city-sd/\">Sell My House Fast in Rapid City, SD</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-aberdeen-sd/\">Sell My House Fast in Aberdeen, SD</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-brookings-sd/\">Sell My House Fast in Brookings, SD</a></p><h3>Property tax guides by city</h3><p><a href=\"https://cashhomebuyersca.com/sioux-falls-sd-property-tax-guide/\">Sioux Falls, SD Property Tax Guide</a></p><h3>Property tax guides by county</h3><p><a href=\"https://cashhomebuyersca.com/minnehaha-county-sd-property-tax-guide/\">Minnehaha County, SD Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/pennington-county-sd-property-tax-guide/\">Pennington County, SD Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/lincoln-county-sd-property-tax-guide/\">Lincoln County, SD Property Tax Guide</a></p></div>\n<div class=\"chb-cta\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#fff;\"><div style=\"max-width:600px;\"><div style=\"font-size:12px;font-weight:800;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Selling in South Dakota?</div><div style=\"font-weight:800;font-size:20px;line-height:1.35;color:#fff;\">We buy South Dakota houses as-is, with no commission, no repairs and no closing costs to you.</div></div><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div></div>\n<!-- /wp:html --<div class='chb-rw'><h2>How is South Dakota laid out for a home seller?</h2><p>South Dakota is split by the Missouri River into two halves that locals call East River and West River. The split matters to a seller because the two halves have different economies, different weather risks and different buyer pools.</p><p>According to <a href='https://en.wikipedia.org/wiki/South_Dakota'>Wikipedia's state overview</a>, eastern South Dakota holds most of the population and grows a variety of crops in fertile soil. West of the river, ranching is the main farm activity, and the economy leans more on tourism and defense spending. Most of the state's seven large Indian reservations are in West River.</p><p>The state became the 40th state on November 2, 1889, and Pierre is the capital. The Black Hills in the southwest rise to Black Elk Peak at 7,244 feet, and Mount Rushmore sits in that range. The Badlands lie east of the Hills in the south.</p><ul><li>East River: Sioux Falls, Brookings and Aberdeen, in the part of the state with most of the people and the cropland.</li><li>West River: Rapid City, the Black Hills and the ranch country, where tourism and defense spending matter more.</li><li>Time zones: the eastern half of the state is on Central Time and the western half is on Mountain Time, which affects closing and recording deadlines if you are coordinating across the river.</li></ul><h2>Which South Dakota counties have the most people?</h2><p>Minnehaha County, home of Sioux Falls, has the most residents, followed by Pennington County (Rapid City) and then Lincoln County just south of Sioux Falls. The Census Bureau puts the three at 212,691, 116,792 and 77,145 people as of July 1, 2025.</p><p>Lincoln County is the fast mover. The Census Bureau's <a href='https://www.census.gov/quickfacts/fact/table/SD,minnehahacountysouthdakota,penningtoncountysouthdakota,lincolncountysouthdakota/PST045224'>QuickFacts comparison</a> shows it up 18.4 percent from the April 2020 base, against 5.5 percent for the whole state.</p><table><thead><tr><th>Area</th><th>Population, July 2025 estimate</th><th>Median value, owner-occupied homes (2020 to 2024)</th><th>Median gross rent</th><th>Owner-occupied rate</th></tr></thead><tbody><tr><td>South Dakota</td><td>935,094</td><td>$257,400</td><td>$946</td><td>68.6%</td></tr><tr><td>Minnehaha County</td><td>212,691</td><td>$287,600</td><td>$978</td><td>63.1%</td></tr><tr><td>Pennington County</td><td>116,792</td><td>$302,200</td><td>$1,120</td><td>69.3%</td></tr><tr><td>Lincoln County</td><td>77,145</td><td>$348,300</td><td>$1,260</td><td>71.2%</td></tr></tbody></table><p>These are Census survey figures for owner-occupied homes in general. They describe the typical home, which is rarely the house a cash buyer is asked to look at.</p><h2>Where are the largest South Dakota cities?</h2><p>Sioux Falls is the largest city by a wide margin, with 192,517 residents in the 2020 census, and Rapid City is second at 74,703. Aberdeen, Brookings and Watertown follow, each in the low to high 20,000s in the 2010 count that Wikipedia lists.</p><p>The directory on this page links our guides for Sioux Falls, Rapid City, Aberdeen and Brookings. Rapid City is the West River city of the group, in the part of the state where Wikipedia says tourism and defense spending carry more weight. The others sit East River, where cropland and the larger population are.</p><p>Ellsworth Air Force Base near Rapid City is described by Wikipedia as the second-largest single employer in the state.</p><div class=\"chb-cta chb-cta-x\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:24px 28px;color:#fff;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;\"><span style=\"display:block;max-width:600px;font-weight:800;font-size:19px;line-height:1.35;color:#fff;\"><span style=\"display:block;font-size:12px;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Free, no-obligation offer</span>Tell us about your South Dakota house and get a written cash offer within 24 hours.</span><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div></div><h2>How does property tax work across South Dakota?</h2><p>South Dakota property tax is local. The Department of Revenue says the state does not collect or spend any property tax revenue, and the money pays for schools, counties, cities and other local units of government.</p><p>The state's <a href='https://dor.sd.gov/media/oeqheqmi/property-tax-101.pdf'>Property Tax 101 fact sheet</a> splits the job in three. The county Director of Equalization assesses every parcel. The county Auditor adds up the requests from each taxing district and sets the levies. The county Treasurer collects the money. A sale does not change that chain, so the county where the house sits is the office you call about a bill.</p><ul><li>Assessment date: November 1, with notices mailed by March 1 of the following year.</li><li>Equalization: values are equalized to 85 percent, so a home with a full and true value of $120,000 has a taxable value of $102,000 in the state's own example.</li><li>Owner-occupied homes get a lower school general fund levy, and the form is due to the Director of Equalization by March 15.</li></ul><p>Our statewide property tax page covers appeals and relief programs in detail. This directory is the place to find your own county.</p><h2>When are South Dakota property taxes due and what happens if they are late?</h2><p>Taxes are due January 1 and can be paid in two halves, the first by April 30 and the second by October 31. Under <a href='https://sdlegislature.gov/api/Statutes/10-21-23.html'>SDCL 10-21-23</a>, one half becomes delinquent on May 1 and the other half on November 1, and interest is added on the first of each month after that at the Category G rate.</p><p>Bills of fifty dollars or less must be paid in full by April 30. If April 30 or October 31 falls on a weekend, the tax is due on the last working day, and a mailed payment counts if it is postmarked by the last day before delinquency.</p><p>Some counties describe the late charge in their own words. Meade County's treasurer page says a 10 percent annual penalty applies and that partial payments and payment plans are not accepted. Meade County also holds its tax certificate sale in December. Check the treasurer for the county you are selling in, since each office posts its own rules.</p><h2>What does it cost to transfer a house in South Dakota?</h2><p>The state charges a real estate transfer fee of fifty cents for each five hundred dollars of value or fraction of that, and the seller (the grantor) pays it. That is written into <a href='https://sdlegislature.gov/api/Statutes/43-4-21.html'>SDCL 43-4-21</a>.</p><p>On a $250,000 sale that works out to $250 by the statute's own rate, since $250,000 holds exactly 500 blocks of $500. Your closing statement will carry other lines too, such as title charges and prorated property tax.</p><p>SDCL 43-4-22 lists transfers that skip the fee. A few that come up for our sellers:</p><ul><li>Transfers under a decree of distribution in a decedent's estate.</li><li>Sheriff's deeds, foreclosure deeds and deeds in lieu of foreclosure.</li><li>Absolute gifts with no consideration of any kind.</li><li>Transfers under a divorce decree or an approved settlement agreement.</li><li>Transfers between husband and wife, or parent and child, for only nominal consideration.</li></ul><p>The Department of Revenue also lists a Certificate of Real Estate Value form, PT 56, among its property tax forms. Ask your title company whether it applies to your deed.</p><div class=\"chb-cta chb-cta-x\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:24px 28px;color:#fff;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;\"><span style=\"display:block;max-width:600px;font-weight:800;font-size:19px;line-height:1.35;color:#fff;\"><span style=\"display:block;font-size:12px;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Sell as-is</span>No repairs, no cleaning and no showings. We buy South Dakota houses in any condition.</span><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">See My Cash Offer &rarr;</a></div></div><h2>Where are deeds and estate affidavits recorded?</h2><p>Deeds and similar documents are filed with the county Register of Deeds, and South Dakota organizes that office by county under Title 7 of the codified laws. When a successor claims real property by affidavit after a death, the affidavit and a certified death certificate go to the register of deeds in every county where the decedent owned land.</p><p>That rule comes from <a href='https://sdlegislature.gov/api/Statutes/29A-3-1203.html'>SDCL 29A-3-1203</a>, which also covers the small estate threshold of $50,000 in real property interests. If you inherited a house in a county you do not live in, plan on dealing with that county's register by mail or through the title company.</p><p>Landlord-tenant cases and probate cases are filed in the state court system, which the Unified Judicial System describes as covering both case types under civil law. The local circuit court clerk is where those papers start, and the UJS site has forms for evictions in particular.</p><h2>What weather and housing risks do South Dakota sellers face?</h2><p>South Dakota has a continental climate with four distinct seasons, and the weather shows up in inspection reports. Wikipedia reports summer thunderstorms with high winds and hail, an average of about 30 tornadoes a year in the eastern part, and severe blizzards and ice storms in winter.</p><p>Precipitation runs from roughly 15 inches in the northwest to about 25 inches in the southeast, so a house in Sioux Falls and a house near the Wyoming line face different moisture conditions. Hail can damage a roof, so buyers often ask how old the shingles are.</p><ul><li>Roofs and siding are worth checking after a hail season.</li><li>A vacant house left unheated through a blizzard season can have frozen plumbing.</li><li>A vacant inherited house should be checked often through winter.</li></ul><p>A cash buyer takes the house with those issues in place, so a seller does not have to replace a roof before listing.</p><h2>How does a cash sale fit into South Dakota's rules?</h2><p>A cash sale uses the same deed, the same transfer fee and the same county recording as any other sale. What changes is the timeline, since there is no lender appraisal or loan approval to wait on.</p><p>That matters in the situations our South Dakota guides cover. A seller who inherited a house may want to move before the three-year window for opening a probate case closes. A landlord with a tenant needs the rules in the landlord-tenant guide. An owner who is behind on taxes needs to know that a tax certificate sale can start a clock toward a tax deed.</p><p>Use the links on this page to find the guide for your city or county. We buy houses as-is, and an offer carries no obligation if you decide not to sell.</p></div><div class=\"chb-cta chb-cta-x\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:24px 28px;color:#fff;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;\"><span style=\"display:block;max-width:600px;font-weight:800;font-size:19px;line-height:1.35;color:#fff;\"><span style=\"display:block;font-size:12px;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">You pick the closing date</span>Close in as little as 7 days or on the date that works for you, with no fees or commissions.</span><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div></div><h2>More questions about South Dakota Guides</h2><h3 class=\"wp-block-heading\">How many people live in South Dakota?</h3><p>The Census Bureau's July 1, 2025 estimate is 935,094 people, up from 886,667 counted in the 2020 census. Minnehaha, Pennington and Lincoln counties are the three most populous of the counties we cover.</p><h3 class=\"wp-block-heading\">Who collects property tax in South Dakota?</h3><p>The county Treasurer collects it. The Department of Revenue says the state does not collect or spend property tax revenue, so the money stays with schools, counties, cities and other local districts.</p><h3 class=\"wp-block-heading\">What is the South Dakota real estate transfer fee?</h3><p>The fee is fifty cents for each five hundred dollars of value, paid by the grantor under SDCL 43-4-21. Transfers under a decree of distribution in an estate, foreclosure deeds and pure gifts are among the exemptions in SDCL 43-4-22.</p><h3 class=\"wp-block-heading\">When are South Dakota property taxes due?</h3><p>Taxes are payable in two halves, by April 30 and October 31. One half is delinquent on May 1 and the second half on November 1, with interest added monthly after that.</p><h3 class=\"wp-block-heading\">Is South Dakota split into regions that affect selling?</h3><p>Yes. The Missouri River divides it into East River and West River. East River holds most of the people and cropland. West River has the Black Hills, ranching, tourism and most reservations.</p><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"How many people live in South Dakota?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The Census Bureau's July 1, 2025 estimate is 935,094 people, up from 886,667 counted in the 2020 census. Minnehaha, Pennington and Lincoln counties are the three most populous of the counties we cover.\"}}, {\"@type\": \"Question\", \"name\": \"Who collects property tax in South Dakota?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The county Treasurer collects it. The Department of Revenue says the state does not collect or spend property tax revenue, so the money stays with schools, counties, cities and other local districts.\"}}, {\"@type\": \"Question\", \"name\": \"What is the South Dakota real estate transfer fee?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The fee is fifty cents for each five hundred dollars of value, paid by the grantor under SDCL 43-4-21. Transfers under a decree of distribution in an estate, foreclosure deeds and pure gifts are among the exemptions in SDCL 43-4-22.\"}}, {\"@type\": \"Question\", \"name\": \"When are South Dakota property taxes due?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Taxes are payable in two halves, by April 30 and October 31. One half is delinquent on May 1 and the second half on November 1, with interest added monthly after that.\"}}, {\"@type\": \"Question\", \"name\": \"Is South Dakota split into regions that affect selling?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Yes. The Missouri River divides it into East River and West River. East River holds most of the people and cropland. West River has the Black Hills, ranching, tourism and most reservations.\"}}]}</script>>", "status": "publish", "rank_math_title": "South Dakota Guides by City and County | Cash Home Buyers", "rank_math_description": "Every South Dakota guide in one place: property tax, probate, foreclosure and selling a house, by statewide topic, city and county. Official sources.", "rank_math_focus_keyword": "south dakota property guides"}]