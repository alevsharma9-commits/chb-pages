[{"slug": "montana-guides-by-city-and-county", "title": "Montana Guides: Property Tax, Probate, Foreclosure and Selling by City and County", "content": "<!-- wp:html -->\n<style>.wsp-hero{position:relative;margin:0 calc(-50vw + 50%);padding:5rem 1.5rem;background-image:none;background:linear-gradient(170deg,#12293f 0%,#0c1c2e 46%,#060c16 100%);overflow:hidden;}.wsp-hero-inner{max-width:1216px;margin:0 auto;display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem;align-items:center;}.wsp-hero-left{text-align:center;}.wsp-hero-left h1{color:#fff;font-size:2.6rem;font-weight:800;line-height:1.15;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left h2{color:#fff;font-weight:300;font-size:1.3rem;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left p{color:#fff;font-size:1rem;font-weight:300;max-width:500px;margin:0 auto 1.5rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-btn-outline{display:inline-flex;align-items:center;border:2px solid #fff;border-radius:30px;padding:.6rem 1.4rem;font-weight:600;color:#fff;text-decoration:none;font-size:.95rem;}.wsp-btn-outline:hover{background:#fff;color:#1A202C;}.wsp-hero-right iframe{width:100%;min-height:560px;border:none;border-radius:4px;}.wsp-wrap{max-width:900px;margin:0 auto;padding:3rem 1.5rem 4rem;}@media (max-width:900px){.wsp-hero-inner{grid-template-columns:1fr;}.wsp-hero-left h1{font-size:2.1rem;}}.wsp-wrap h3{background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #3182CE;border-radius:8px;padding:.9rem 1.25rem;margin:1.75rem 0 0;font-size:1.05rem;font-weight:700;color:#1A202C;}.wsp-wrap h3+p{background:#fff;border:1px solid #e2e8f0;border-top:none;border-radius:0 0 8px 8px;padding:1rem 1.25rem;margin:0 0 .25rem;color:#444;}.wsp-wrap table td{vertical-align:top;}.chb-cta p{margin:0}.wsp-related{margin:2.5rem 0 1rem}.wsp-related h2{font-size:1.3rem;margin-bottom:1rem;font-weight:600;}.wsp-related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}.wsp-related-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:1.1rem 1.25rem;}.wsp-related-card a{font-weight:700;color:var(--global-palette1, #3182CE);text-decoration:none;}.wsp-related-card a:hover{text-decoration:underline;}.wsp-related-card p{margin:.35rem 0 0;font-size:.9rem;color:#555;}.wsp-hero a.wsp-btn-call{background:#E0A83C !important;border:2px solid #E0A83C !important;color:#16203A !important;font-size:1.25rem !important;font-weight:800 !important;padding:1rem 2.2rem !important;border-radius:40px !important;box-shadow:0 0 0 4px rgba(224,168,60,.25),0 8px 26px rgba(224,168,60,.5) !important;text-shadow:none !important;}.wsp-hero a.wsp-btn-call strong{color:#16203A !important;}.wsp-hero a.wsp-btn-call:hover{background:#fff !important;border-color:#fff !important;}</style><div class='wsp-hero'><div class='wsp-hero-inner'><div class='wsp-hero-left'><h1>Montana Guides: Property Tax, Probate, Foreclosure and Selling by City and County</h1><div class=wsp-kicker>Cash Home Buyers in Montana</div><div class=wsp-speed><span>Cash Offer in 24 Hours</span></div><ul class=wsp-checks><li>Montana Guides: inherited, behind on payments, tenants or repairs, we buy the house as-is</li><li>No fees, commissions or closing costs on a Montana Guides sale</li><li>Turn the Montana Guides offer down and you owe us nothing</li></ul><h2>Sell Your Montana House for Cash</h2><p>Tell us about your Montana house.</p><p><a class='wsp-btn-outline wsp-btn-call' href='tel:424-435-2326'>Call or Text <strong>&nbsp;(424) 435-2326</strong></a></p></div><div class='wsp-hero-right'><iframe src='https://connect.cashhomebuyersca.com/widget/form/zKzKbSeB3aqwWwE8NNxO' data-form-id='zKzKbSeB3aqwWwE8NNxO' title='Cash Offer Form'></iframe><br /><script src='https://connect.cashhomebuyersca.com/js/form_embed.js' async></script></div></div></div><div class='wsp-wrap'><p><em>Last updated November 14, 2026.</em></p><div class=\"wsp-related\"><h3>Statewide guides</h3><p><a href=\"https://cashhomebuyersca.com/montana-property-tax-guide/\">Montana Property Tax Guide: Appeals</a> <a href=\"https://cashhomebuyersca.com/montana-homestead-exemption/\">Montana Homestead Exemption Guide</a> <a href=\"https://cashhomebuyersca.com/montana-estate-tax/\">Montana Estate and Inheritance Tax</a> <a href=\"https://cashhomebuyersca.com/montana-quitclaim-deed/\">Montana Quitclaim Deed: Recording and Fees</a> <a href=\"https://cashhomebuyersca.com/montana-capital-gains-tax/\">Montana Capital Gains Tax on a House Sale</a></p><h3>Sell my house by city</h3><p><a href=\"https://cashhomebuyersca.com/sell-my-house-fast-billings-mt/\">Sell My House Fast in Billings, MT</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-missoula-mt/\">Sell My House Fast in Missoula, MT</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-great-falls-mt/\">Sell My House Fast in Great Falls, MT</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-bozeman-mt/\">Sell My House Fast in Bozeman, MT</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-butte-mt/\">Sell My House Fast in Butte, MT</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-helena-mt/\">Sell My House Fast in Helena, MT</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-kalispell-mt/\">Sell My House Fast in Kalispell, MT</a></p><h3>Property tax guides by city</h3><p><a href=\"https://cashhomebuyersca.com/missoula-mt-property-tax-guide/\">Missoula, MT Property Tax Guide</a></p><h3>Property tax guides by county</h3><p><a href=\"https://cashhomebuyersca.com/yellowstone-county-mt-property-tax-guide/\">Yellowstone County, MT Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/gallatin-county-mt-property-tax-guide/\">Gallatin County, MT Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/cascade-county-mt-property-tax-guide/\">Cascade County, MT Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/ravalli-county-mt-property-tax-guide/\">Ravalli County, MT Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/flathead-county-mt-property-tax-guide/\">Flathead County, MT Property Tax Guide</a></p></div>\n<div class=\"chb-cta\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#fff;\"><div style=\"max-width:600px;\"><div style=\"font-size:12px;font-weight:800;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Selling in Montana?</div><div style=\"font-weight:800;font-size:20px;line-height:1.35;color:#fff;\">We buy Montana houses as-is, with no commission, no repairs and no closing costs to you.</div></div><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div><p><em>This is general information about Montana Guides, not legal or tax advice. Confirm details with the official office or a licensed professional.</em></p></div>\n<!-- /wp:html --<div class='chb-rw'><h2>How is Montana organized for a house seller?</h2><p>Montana has 56 counties, and nearly every step of a sale runs through the county where the house sits. The county clerk and recorder records the deed, the county treasurer bills and collects property tax, and the state Department of Revenue values the property.</p><p>The state is large and uneven. County populations range from 548 to 172,692, and the smallest county by population, Petroleum County, covers 1,654 square miles. Two places run as consolidated city-counties, one linked to Deer Lodge County and one to Silver Bow County, so city and county government are combined there.</p><p>A seller in Billings, a seller in Missoula and a seller on a ranch in the northeast face the same state forms and statutes, but they deal with different offices, different mill levies and different local districts.</p><h2>Which regions does Montana use to administer water rights on a sale?</h2><p>The Department of Natural Resources and Conservation runs eight Water Resources regional offices, and they are a useful way to picture how the state divides itself. Every Montana deed recorded with a Realty Transfer Certificate carries a water right disclosure, so the regional office for the county matters if the property has an irrigation or well right.</p><table><thead><tr><th>Regional office</th><th>Counties served</th></tr></thead><tbody><tr><td>Billings</td><td>Big Horn, Carbon, Carter, Custer, Fallon, Powder River, Prairie, Rosebud, Stillwater, Sweet Grass, Treasure, Yellowstone</td></tr><tr><td>Bozeman</td><td>Gallatin, Madison, Park</td></tr><tr><td>Glasgow</td><td>Daniels, Dawson, Garfield, McCone, Phillips, Richland, Roosevelt, Sheridan, Valley, Wibaux</td></tr><tr><td>Havre</td><td>Blaine, Chouteau, Glacier, Hill, Liberty, Pondera, Teton, Toole</td></tr><tr><td>Helena</td><td>Beaverhead, Broadwater, Deer Lodge, Jefferson, Lewis and Clark, Powell, Silver Bow</td></tr><tr><td>Kalispell</td><td>Flathead, Lake, Lincoln, Sanders</td></tr><tr><td>Lewistown</td><td>Cascade, Fergus, Golden Valley, Judith Basin, Meagher, Musselshell, Petroleum, Wheatland</td></tr><tr><td>Missoula</td><td>Granite, Mineral, Missoula, Ravalli</td></tr></tbody></table><p>Our Montana city and county guides cover Billings, Missoula, Great Falls, Bozeman, Butte, Helena and Kalispell, and the Yellowstone, Gallatin, Cascade, Ravalli and Flathead county tax pages. Those places fall in the Billings, Bozeman, Lewistown, Missoula, Helena and Kalispell regions above.</p><h2>What is the Realty Transfer Certificate and who files it?</h2><p>Any party transferring real property in Montana files a Realty Transfer Certificate with the county clerk and recorder when the deed is presented for recording. The Montana Department of Revenue form applies whether or not a deed is involved, and a missing or inaccurate form can bring a $500 penalty, six months in jail, or both.</p><p>The certificate collects the following information:</p><ul><li>Date of transfer, taken as the date the deed was signed unless the deed says otherwise.</li><li>Seller and buyer names and mailing addresses, with the last four digits of each Social Security or federal ID number.</li><li>Whether each party treats the property as a principal residence, meaning occupied for at least seven months.</li><li>Sale price and financing type: cash, FHA, VA, contract or other.</li><li>A water right disclosure signed by the seller.</li></ul><p>The department changes its ownership record, which drives the tax bill, once the form is complete and signed by the preparer. Sale information on the form is confidential for Department of Revenue use.</p><h2>How does Montana run property tax across all 56 counties?</h2><p>The state values the property and the county sends the bill. The Department of Revenue's Property Assessment Division values all taxable property at 100 percent of market value, and county governments use those values to calculate the tax.</p><p>Residential property is reappraised every two years. Notices go to owners, and you can ask for informal review or appeal to a county tax appeal board.</p><p>Under <a href=\"https://mca.legmt.gov/bills/mca/title_0150/chapter_0160/part_0010/section_0020/0150-0160-0010-0020.html\">MCA 15-16-102</a>, the statewide schedule is the same in every county:</p><table><thead><tr><th>Item</th><th>Rule</th></tr></thead><tbody><tr><td>First half due</td><td>5 p.m. on November 30, or 30 days after the notice is postmarked, whichever is later</td></tr><tr><td>Second half due</td><td>5 p.m. on May 31</td></tr><tr><td>Weekend or holiday</td><td>Next business day</td></tr><tr><td>Delinquent</td><td>2% penalty plus interest of 5/6 of 1% a month</td></tr><tr><td>Primary residence option</td><td>Seven nearly equal payments, November 30 through May 31</td></tr></tbody></table><p>Missoula County also reports that tax liens attach on the first business day of August after delinquency and that the owner then has two to three years to pay. Other counties follow the same statute, but check each treasurer's page for local dates and fees.</p><h2>What is the 2026 residential tax rate structure in Montana?</h2><p>For 2026, Montana taxes primary residences and long-term rentals at tiered rates and everything else at a flat 1.90%. The tiers are 0.76% on the first $378,000 of market value, 0.90% from $378,001 to $756,000, 1.10% from $756,001 to $1,511,999, and 1.90% above $1,512,000.</p><ul><li>Primary residences qualify when the owner lives in the home seven or more months of the year.</li><li>Long-term rentals must be rented 28 or more days at a time for at least seven months.</li><li>Second homes, short-term rentals and vacant residential lots pay the flat 1.90%.</li><li>Commercial and industrial property pays 1.50% below $2,274,000 and 1.90% at or above that amount.</li><li>Non-qualified agricultural land is taxed at 14.35%, qualified agricultural land at 2.05% and forest land at 0.37%.</li></ul><p>The department opened enrollment for 2027 homestead and long-term rental rates, so owners who want the reduced rate next year should check the enrollment page.</p><h2>How does a Montana foreclosure work, and how long do owners have?</h2><p>When a loan is secured by a trust indenture, the trustee can foreclose by advertisement and sale. Under MCA 71-1-315, the trustee must mail the recorded notice of sale by certified mail at least 120 days before the sale to the grantor and other listed parties.</p><ul><li>At least 20 days before the sale, the notice must be posted on the property.</li><li>The notice is published in a newspaper once a week for three successive weeks, with the last publication at least 20 days before the sale.</li><li>The sale is a public auction to the highest bidder, who pays in cash.</li><li>A sale may be postponed up to 15 days by proclamation, and a bankruptcy or court stay can extend it in steps of up to 30 days, up to 120 days in total.</li></ul><p>A 120-day notice period gives an owner time to sell before the auction. Selling to a buyer who can close in a few weeks can pay off the loan and avoid the auction record, though every case differs and a lawyer should review it.</p><h2>How does probate and inherited property work across Montana?</h2><p>Probate follows the Uniform Probate Code in MCA Title 72, and the Montana Judicial Branch says both informal and formal proceedings exist. The right one depends on the estate's value and whether there is a valid will.</p><p>The personal representative may sell estate real property for cash or on credit, at public or private sale, unless the will or a court order limits that power. Montana collects no estate or inheritance tax, according to the Department of Revenue. Our statewide Montana estate tax guide explains this and the date-of-death basis rule for inherited homes.</p><p>Houses that pass by joint tenancy or a transfer on death deed skip probate but still need the Realty Transfer Certificate, with a certified death certificate attached.</p><h2>What taxes apply when a Montana house is sold?</h2><p>Property tax is paid at closing, and income tax on any gain is reported later. Montana taxes net long-term capital gains at 3.0% and 4.1% in 2026 and 2027, and sellers of a main home may exclude up to $250,000 of gain under federal rules, or $500,000 on a joint return.</p><p>Montana ordinary income is taxed at 4.7% up to the bracket limit and 5.65% above it in 2026. Our Montana capital gains guide has the bracket numbers.</p><p>Before you list, gather the last property tax bill, any delinquency notice, your basis records, and a payoff statement for any loan. A title company can then show your estimated net from the sale, including prorated tax.</p><h2>How do you choose the right Montana guide?</h2><p>Start with the county where the house sits. That county decides your tax office, your recorder and your tax lien process, while the state decides your forms, rates and statutes.</p><ul><li>For tax dates, appeals and tax liens, use a county or city property tax guide.</li><li>For selling a house quickly, use the city guide for the nearest listed city.</li><li>For income tax, inherited property and homestead rules, use the statewide guides.</li></ul><p>If the county or city you need is not listed yet, the statewide forms and statutes above still apply, and our team can explain what a cash sale would involve.</p></div><h2>More questions about Montana Guides</h2><h3 class=\"wp-block-heading\">How many counties does Montana have?</h3><p>Montana has 56 counties, with populations from 548 to 172,692. Two city-county governments are consolidated, tied to Deer Lodge County and Silver Bow County.</p><h3 class=\"wp-block-heading\">When is Montana property tax due?</h3><p>Half is due by 5 p.m. on November 30, or 30 days after the notice is postmarked if that is later, and half by 5 p.m. on May 31. A weekend or holiday moves the date to the next business day.</p><h3 class=\"wp-block-heading\">What is the Montana property tax rate for a home in 2026?</h3><p>A qualifying primary residence pays 0.76% on the first $378,000 of value, 0.90% to $756,000, 1.10% to $1,511,999 and 1.90% above. Second homes and short-term rentals pay a flat 1.90%.</p><h3 class=\"wp-block-heading\">Do I have to file anything when I sell a house in Montana?</h3><p>Yes. A Realty Transfer Certificate goes to the county clerk and recorder when the deed is presented for recording, and it includes a water right disclosure.</p><h3 class=\"wp-block-heading\">How long does a Montana trust indenture foreclosure take?</h3><p>The trustee must mail notice at least 120 days before the sale, per MCA 71-1-315, and the notice is also posted and published. Court or bankruptcy stays can postpone the sale.</p><h3 class=\"wp-block-heading\">Does Montana tax estates or inheritances?</h3><p>No. The Department of Revenue says Montana has no estate or inheritance tax for current deaths. The federal estate tax can apply to estates above $15,000,000 for 2026 deaths.</p><h3 class=\"wp-block-heading\">Where do I record a Montana deed?</h3><p>With the clerk and recorder in the county where the property sits. In Missoula County, the Clerk and Recorder is also the Treasurer.</p><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"How many counties does Montana have?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Montana has 56 counties, with populations from 548 to 172,692. Two city-county governments are consolidated, tied to Deer Lodge County and Silver Bow County.\"}}, {\"@type\": \"Question\", \"name\": \"When is Montana property tax due?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Half is due by 5 p.m. on November 30, or 30 days after the notice is postmarked if that is later, and half by 5 p.m. on May 31. A weekend or holiday moves the date to the next business day.\"}}, {\"@type\": \"Question\", \"name\": \"What is the Montana property tax rate for a home in 2026?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"A qualifying primary residence pays 0.76% on the first $378,000 of value, 0.90% to $756,000, 1.10% to $1,511,999 and 1.90% above. Second homes and short-term rentals pay a flat 1.90%.\"}}, {\"@type\": \"Question\", \"name\": \"Do I have to file anything when I sell a house in Montana?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Yes. A Realty Transfer Certificate goes to the county clerk and recorder when the deed is presented for recording, and it includes a water right disclosure.\"}}, {\"@type\": \"Question\", \"name\": \"How long does a Montana trust indenture foreclosure take?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The trustee must mail notice at least 120 days before the sale, per MCA 71-1-315, and the notice is also posted and published. Court or bankruptcy stays can postpone the sale.\"}}, {\"@type\": \"Question\", \"name\": \"Does Montana tax estates or inheritances?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"No. The Department of Revenue says Montana has no estate or inheritance tax for current deaths. The federal estate tax can apply to estates above $15,000,000 for 2026 deaths.\"}}, {\"@type\": \"Question\", \"name\": \"Where do I record a Montana deed?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"With the clerk and recorder in the county where the property sits. In Missoula County, the Clerk and Recorder is also the Treasurer.\"}}]}</script>>", "status": "publish", "rank_math_title": "Montana Guides by City and County | Cash Home Buyers", "rank_math_description": "Every Montana guide in one place: property tax, probate, foreclosure and selling a house, by statewide topic, city and county. Official sources.", "rank_math_focus_keyword": "montana property guides"}]