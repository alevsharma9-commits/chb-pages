[{"slug": "maine-guides-by-city-and-county", "title": "Maine Guides: Property Tax, Probate, Foreclosure and Selling by City and County", "content": "<!-- wp:html -->\n<style>.wsp-hero{position:relative;margin:0 calc(-50vw + 50%);padding:5rem 1.5rem;background-image:none;background:linear-gradient(170deg,#12293f 0%,#0c1c2e 46%,#060c16 100%);overflow:hidden;}.wsp-hero-inner{max-width:1216px;margin:0 auto;display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem;align-items:center;}.wsp-hero-left{text-align:center;}.wsp-hero-left h1{color:#fff;font-size:2.6rem;font-weight:800;line-height:1.15;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left h2{color:#fff;font-weight:300;font-size:1.3rem;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left p{color:#fff;font-size:1rem;font-weight:300;max-width:500px;margin:0 auto 1.5rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-btn-outline{display:inline-flex;align-items:center;border:2px solid #fff;border-radius:30px;padding:.6rem 1.4rem;font-weight:600;color:#fff;text-decoration:none;font-size:.95rem;}.wsp-btn-outline:hover{background:#fff;color:#1A202C;}.wsp-hero-right iframe{width:100%;min-height:560px;border:none;border-radius:4px;}.wsp-wrap{max-width:900px;margin:0 auto;padding:3rem 1.5rem 4rem;}@media (max-width:900px){.wsp-hero-inner{grid-template-columns:1fr;}.wsp-hero-left h1{font-size:2.1rem;}}.wsp-wrap h3{background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #3182CE;border-radius:8px;padding:.9rem 1.25rem;margin:1.75rem 0 0;font-size:1.05rem;font-weight:700;color:#1A202C;}.wsp-wrap h3+p{background:#fff;border:1px solid #e2e8f0;border-top:none;border-radius:0 0 8px 8px;padding:1rem 1.25rem;margin:0 0 .25rem;color:#444;}.wsp-wrap table td{vertical-align:top;}.chb-cta p{margin:0}.wsp-related{margin:2.5rem 0 1rem}.wsp-related h2{font-size:1.3rem;margin-bottom:1rem;font-weight:600;}.wsp-related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}.wsp-related-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:1.1rem 1.25rem;}.wsp-related-card a{font-weight:700;color:var(--global-palette1, #3182CE);text-decoration:none;}.wsp-related-card a:hover{text-decoration:underline;}.wsp-related-card p{margin:.35rem 0 0;font-size:.9rem;color:#555;}.wsp-hero a.wsp-btn-call{background:#E0A83C !important;border:2px solid #E0A83C !important;color:#16203A !important;font-size:1.25rem !important;font-weight:800 !important;padding:1rem 2.2rem !important;border-radius:40px !important;box-shadow:0 0 0 4px rgba(224,168,60,.25),0 8px 26px rgba(224,168,60,.5) !important;text-shadow:none !important;}.wsp-hero a.wsp-btn-call strong{color:#16203A !important;}.wsp-hero a.wsp-btn-call:hover{background:#fff !important;border-color:#fff !important;}</style><div class='wsp-hero'><div class='wsp-hero-inner'><div class='wsp-hero-left'><h1>Maine Guides: Property Tax, Probate, Foreclosure and Selling by City and County</h1><div class=wsp-kicker>Cash Home Buyers in Maine</div><div class=wsp-speed><span>Cash Offer in 24 Hours</span></div><ul class=wsp-checks><li>Maine Guides: inherited, behind on payments, tenants or repairs, we buy the house as-is</li><li>No fees, commissions or closing costs on a Maine Guides sale</li><li>Turn the Maine Guides offer down and you owe us nothing</li></ul><h2>Sell Your Maine House for Cash</h2><p>Tell us about your Maine house.</p><p><a class='wsp-btn-outline wsp-btn-call' href='tel:424-435-2326'>Call or Text <strong>&nbsp;(424) 435-2326</strong></a></p></div><div class='wsp-hero-right'><iframe src='https://connect.cashhomebuyersca.com/widget/form/zKzKbSeB3aqwWwE8NNxO' data-form-id='zKzKbSeB3aqwWwE8NNxO' title='Cash Offer Form'></iframe><br /><script src='https://connect.cashhomebuyersca.com/js/form_embed.js' async></script></div></div></div><div class='wsp-wrap'><p><em>Last updated November 14, 2026.</em></p><div class=\"wsp-related\"><h3>Statewide guides</h3><p><a href=\"https://cashhomebuyersca.com/maine-property-tax-guide/\">Maine Property Tax Guide: Appeals</a> <a href=\"https://cashhomebuyersca.com/maine-homestead-exemption/\">Maine Homestead Exemption Guide</a> <a href=\"https://cashhomebuyersca.com/maine-estate-tax/\">Maine Estate and Inheritance Tax</a> <a href=\"https://cashhomebuyersca.com/maine-eviction-process/\">Maine Eviction Process and Tenants</a> <a href=\"https://cashhomebuyersca.com/maine-probate-process/\">Maine Probate Process Explained</a> <a href=\"https://cashhomebuyersca.com/maine-capital-gains-tax/\">Maine Capital Gains Tax on a House Sale</a> <a href=\"https://cashhomebuyersca.com/maine-transfer-tax/\">Maine Real Estate Transfer Tax Explained</a> <a href=\"https://cashhomebuyersca.com/maine-recording-deeds/\">Maine Recording a Deed Guide</a></p><h3>Sell my house by city</h3><p><a href=\"https://cashhomebuyersca.com/sell-my-house-fast-portland-me/\">Sell My House Fast in Portland, ME</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-lewiston-me/\">Sell My House Fast in Lewiston, ME</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-bangor-me/\">Sell My House Fast in Bangor, ME</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-south-portland-me/\">Sell My House Fast in South Portland, ME</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-auburn-me/\">Sell My House Fast in Auburn, ME</a></p></div>\n<div class=\"chb-cta\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#fff;\"><div style=\"max-width:600px;\"><div style=\"font-size:12px;font-weight:800;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Selling in Maine?</div><div style=\"font-weight:800;font-size:20px;line-height:1.35;color:#fff;\">We buy Maine houses as-is, with no commission, no repairs and no closing costs to you.</div></div><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div><p><em>This is general information about Maine Guides, not legal or tax advice. Confirm details with the official office or a licensed professional.</em></p></div>\n<!-- /wp:html --<div class='chb-rw'><h2>What should a Maine home seller know about the state as a whole?</h2><p>Maine is large, thinly settled and run town by town, which shapes how a house sale works. The Census Bureau's <a href=\"https://www.census.gov/quickfacts/fact/table/ME,portlandcitymaine,lewistoncitymaine,bangorcitymaine/PST045224\">QuickFacts</a> puts the state's July 2025 population estimate at 1,414,874 across 30,845 square miles of land, or about 44 people per square mile.</p><p>The same source shows 771,492 housing units and an owner-occupied housing rate of 74.3 percent for 2020 to 2024. The median value of an owner-occupied home was $296,600 over that period, a survey figure and not a price for any one house. Values differ a lot by town, and the guides linked on this page cover the main cities.</p><p>For sellers this has practical meaning. Property tax, code questions and many permits are handled by the municipality, while deeds and liens are recorded at a county registry. The statewide guides cover rules that apply everywhere, and the city pages cover local detail.</p><h2>Which Maine cities and counties are the largest?</h2><p>Portland is the largest city, followed by Lewiston and Bangor. The table uses Census QuickFacts figures for July 1, 2025 estimates and 2020 to 2024 survey data.</p><table><thead><tr><th>City</th><th>Population (2025 estimate)</th><th>Owner-occupied rate</th><th>Median owner-occupied home value</th><th>Median gross rent</th></tr></thead><tbody><tr><td>Portland</td><td>69,911</td><td>46.9%</td><td>$489,600</td><td>$1,577</td></tr><tr><td>Lewiston</td><td>38,866</td><td>51.2%</td><td>$235,100</td><td>$986</td></tr><tr><td>Bangor</td><td>32,518</td><td>47.2%</td><td>$219,600</td><td>$1,055</td></tr></tbody></table><p>The largest counties by 2025 population estimate are Cumberland (317,222), York (222,434), Penobscot (157,967), Kennebec (129,067) and Androscoggin (116,487). Aroostook is far larger in land area, at 6,671 square miles, but holds 66,609 people. That spread explains why a seller in Aroostook and a seller in Cumberland deal with very different buyer pools and travel distances.</p><p>In Portland, Lewiston and Bangor, fewer than half of households own their homes, so investor-owned rentals are common. That connects to our <a href=\"/maine-eviction-process/\">Maine eviction guide</a> for owners selling a rented house.</p><h2>How is property tax run in Maine?</h2><p>Each municipality values property and sets its own rate. The Maine Property Tax Division's introductory course says all property is valued as of April 1 each year under 36 M.R.S. \u00a7502, and that the mill rate is the municipal budget plus an overlay, divided by total municipal value.</p><ul><li>The assessor lists every parcel in the valuation book, and the commitment book goes to the tax collector.</li><li>Municipalities have different fiscal years and tax due dates, according to the state's buyer and seller notice.</li><li>A municipality sends its Municipal Valuation Return to the state by November 1, or 30 days after commitment if later.</li><li>The state publishes a transfer tax declaration, bulletins and an assessment manual through Maine Revenue Services.</li></ul><p>Because the city or town does the billing, the first call about a tax question is the town office. Each city page and our <a href=\"/maine-property-tax-guide/\">Maine property tax guide</a> goes deeper.</p><h2>Who owes the property tax when a Maine house sells?</h2><p>Under Maine law, the person who owns the property on April 1 is responsible for that year's tax. The state's <a href=\"https://www.maine.gov/revenue/sites/maine.gov.revenue/files/inline-files/buyersandsellers.pdf\">notice for buyers and sellers</a> says the parties can agree to divide the taxes, but if any part goes unpaid, a lien is filed in the name of the April 1 owner.</p><p>The notice warns that a seller can see credit damage from a lien even after the house is sold, and a buyer can face foreclosure if a lien is filed in the seller's name and the tax goes unpaid. It recommends setting funds aside in escrow at closing.</p><p>Tax liens in Maine move on a fixed clock under 36 M.R.S. \u00a7\u00a7942 and 943.</p><ol><li>The tax collector may send a written demand after 8 months and within one year of the original commitment.</li><li>The owner has 30 days to pay.</li><li>The collector then records a tax lien certificate at the registry of deeds within 10 days.</li><li>If the lien mortgage, interest and costs are not paid within 18 months of filing, it is deemed foreclosed and the right of redemption expires.</li></ol><p>Once foreclosed, the municipality owns the property. That is why a seller with unpaid tax should deal with it before the lien matures.</p><h2>What can an owner do if the assessment looks too high?</h2><p>Ask the municipality for an abatement. The state's course material says a written abatement request must be made within 185 days of commitment, or the assessor can act on their own within one year.</p><ul><li>An appeal after a denial goes to the local board of assessment review or the county commissioners within 60 days.</li><li>The State Board of Property Tax Review hears certain appeals, such as current-use property or nonresidential property valued at $1 million or more.</li><li>A further appeal to superior court must be filed within 30 days of the board or commissioners' decision.</li><li>The state also lists exemptions for veterans, blind persons, homestead and others.</li></ul><p>These deadlines matter for a sale because a pending abatement can change the amount a closing agent needs to hold back for the tax.</p><h2>What does the Maine real estate transfer tax cost?</h2><p>The base rate is $2.20 for each $500 or fractional part of $500 of the property's value. <a href=\"https://www.maine.gov/revenue/taxes/property-tax/transfer-tax\">Maine Revenue Services</a> says the tax falls half on the seller and half on the buyer.</p><p>For transfers on or after November 1, 2025, an additional $3.80 applies to each $500 or fractional part of $500 above $1 million. State bulletin No. 31 works the base case: a $500,000 house at $2.20 per $500 produces $2,200 of tax in total.</p><ul><li>The registry of deeds for the county where the house sits computes and collects the tax from the declaration of value.</li><li>The declaration (Form RETTD) is filed with the registry when the deed is recorded.</li><li>The declaration must include the adjusted assessed value, which is the municipal assessed value divided by the certified ratio, available from the municipal assessor.</li><li>Federal and Maine government agencies are exempt, and certain other transfers are exempt under 36 M.R.S. \u00a74641-C.</li></ul><h2>Where are deeds recorded in Maine?</h2><p>Deeds go to the registry of deeds for the county or district where the property is located. Maine Revenue Services lists <a href=\"https://www.maine.gov/revenue/taxes/property-tax/transfer-tax/county-registries-of-deeds\">17 registry offices</a>: one per county, except Aroostook, which has a northern office in Fort Kent and a southern office in Houlton.</p><table><thead><tr><th>Registry</th><th>Location</th></tr></thead><tbody><tr><td>Cumberland County</td><td>27 Northport Dr., Portland</td></tr><tr><td>York County</td><td>45 Kennebunk Road, Alfred</td></tr><tr><td>Penobscot County</td><td>97 Hammond St., Bangor</td></tr><tr><td>Kennebec County</td><td>77 Winthrop Street, Augusta</td></tr><tr><td>Androscoggin County</td><td>2 Turner Street, Unit 4, Auburn</td></tr></tbody></table><p>Several counties offer online search and fraud alert services, and the statewide portal at maineregistryofdeeds.com links to them. The portal notes that processes vary by county, so call the local office before you send a deed.</p><h2>What other Maine issues come up when selling a house?</h2><p>Inherited houses, tax liens, tenants and out-of-state owners are the common ones. Each has a statewide guide linked on this page, and each ties to a deadline or a form.</p><ul><li>An estate must clear Maine's estate tax lien with a certificate recorded at the registry. The exclusion is $7,160,000 for 2026.</li><li>A nonresident seller faces 2.5 percent real estate withholding on sales of $100,000 or more.</li><li>A rented house needs the security deposit accounting before closing.</li><li>A house with unpaid property tax needs a payoff plan before the 18-month lien clock runs.</li></ul><p>We buy Maine houses as-is for cash, in any condition, from Portland to Aroostook County. Use the statewide guides for the rules and the city pages for local detail. For your own situation, ask a Maine attorney or the town office.</p></div><h2>More questions about Maine Guides</h2><h3 class=\"wp-block-heading\">What are the largest cities in Maine?</h3><p>Portland, Lewiston and Bangor. The Census Bureau's July 2025 estimates are 69,911 for Portland, 38,866 for Lewiston and 32,518 for Bangor.</p><h3 class=\"wp-block-heading\">How many counties and registries of deeds does Maine have?</h3><p>Maine Revenue Services lists 17 registry of deeds offices. Each county has one, except Aroostook, which has a northern office in Fort Kent and a southern office in Houlton.</p><h3 class=\"wp-block-heading\">Who pays the Maine transfer tax?</h3><p>The seller and buyer split it. The base rate is $2.20 per $500 of value, with half imposed on each side. Since November 1, 2025, an extra $3.80 per $500 applies to value above $1 million.</p><h3 class=\"wp-block-heading\">Who owes property tax if I sell my Maine house mid-year?</h3><p>Under Maine law, the person who owns the property on April 1 is responsible for the tax. Buyer and seller may agree to split it, but a lien is filed in the April 1 owner's name if it is not paid.</p><h3 class=\"wp-block-heading\">How long do I have to challenge a Maine property assessment?</h3><p>A written abatement request must be made within 185 days of commitment. If denied, you generally have 60 days to appeal to the board of assessment review or county commissioners, then 30 days to go to superior court.</p><h3 class=\"wp-block-heading\">What happens if property tax stays unpaid in Maine?</h3><p>The municipality can record a tax lien certificate after a 30-day demand. If the lien mortgage, interest and costs are not paid within 18 months of filing, it is deemed foreclosed and the right of redemption ends.</p><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"What are the largest cities in Maine?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Portland, Lewiston and Bangor. The Census Bureau's July 2025 estimates are 69,911 for Portland, 38,866 for Lewiston and 32,518 for Bangor.\"}}, {\"@type\": \"Question\", \"name\": \"How many counties and registries of deeds does Maine have?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Maine Revenue Services lists 17 registry of deeds offices. Each county has one, except Aroostook, which has a northern office in Fort Kent and a southern office in Houlton.\"}}, {\"@type\": \"Question\", \"name\": \"Who pays the Maine transfer tax?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The seller and buyer split it. The base rate is $2.20 per $500 of value, with half imposed on each side. Since November 1, 2025, an extra $3.80 per $500 applies to value above $1 million.\"}}, {\"@type\": \"Question\", \"name\": \"Who owes property tax if I sell my Maine house mid-year?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Under Maine law, the person who owns the property on April 1 is responsible for the tax. Buyer and seller may agree to split it, but a lien is filed in the April 1 owner's name if it is not paid.\"}}, {\"@type\": \"Question\", \"name\": \"How long do I have to challenge a Maine property assessment?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"A written abatement request must be made within 185 days of commitment. If denied, you generally have 60 days to appeal to the board of assessment review or county commissioners, then 30 days to go to superior court.\"}}, {\"@type\": \"Question\", \"name\": \"What happens if property tax stays unpaid in Maine?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The municipality can record a tax lien certificate after a 30-day demand. If the lien mortgage, interest and costs are not paid within 18 months of filing, it is deemed foreclosed and the right of redemption ends.\"}}]}</script>>", "status": "publish", "rank_math_title": "Maine Guides by City and County | Cash Home Buyers", "rank_math_description": "Every Maine guide in one place: property tax, probate, foreclosure and selling a house, by statewide topic, city and county. Official sources.", "rank_math_focus_keyword": "maine property guides"}]