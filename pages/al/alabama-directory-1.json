[{"slug": "alabama-guides-by-city-and-county", "title": "Alabama Guides: Property Tax, Probate, Foreclosure and Selling by City and County", "content": "<!-- wp:html -->\n<style>.wsp-hero{position:relative;margin:0 calc(-50vw + 50%);padding:5rem 1.5rem;background-image:none;background:linear-gradient(170deg,#12293f 0%,#0c1c2e 46%,#060c16 100%);overflow:hidden;}.wsp-hero-inner{max-width:1216px;margin:0 auto;display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem;align-items:center;}.wsp-hero-left{text-align:center;}.wsp-hero-left h1{color:#fff;font-size:2.6rem;font-weight:800;line-height:1.15;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left h2{color:#fff;font-weight:300;font-size:1.3rem;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left p{color:#fff;font-size:1rem;font-weight:300;max-width:500px;margin:0 auto 1.5rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-btn-outline{display:inline-flex;align-items:center;border:2px solid #fff;border-radius:30px;padding:.6rem 1.4rem;font-weight:600;color:#fff;text-decoration:none;font-size:.95rem;}.wsp-btn-outline:hover{background:#fff;color:#1A202C;}.wsp-hero-right iframe{width:100%;min-height:560px;border:none;border-radius:4px;}.wsp-wrap{max-width:900px;margin:0 auto;padding:3rem 1.5rem 4rem;}@media (max-width:900px){.wsp-hero-inner{grid-template-columns:1fr;}.wsp-hero-left h1{font-size:2.1rem;}}.wsp-wrap h3{background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #3182CE;border-radius:8px;padding:.9rem 1.25rem;margin:1.75rem 0 0;font-size:1.05rem;font-weight:700;color:#1A202C;}.wsp-wrap h3+p{background:#fff;border:1px solid #e2e8f0;border-top:none;border-radius:0 0 8px 8px;padding:1rem 1.25rem;margin:0 0 .25rem;color:#444;}.wsp-wrap table td{vertical-align:top;}.chb-cta p{margin:0}.wsp-related{margin:2.5rem 0 1rem}.wsp-related h2{font-size:1.3rem;margin-bottom:1rem;font-weight:600;}.wsp-related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}.wsp-related-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:1.1rem 1.25rem;}.wsp-related-card a{font-weight:700;color:var(--global-palette1, #3182CE);text-decoration:none;}.wsp-related-card a:hover{text-decoration:underline;}.wsp-related-card p{margin:.35rem 0 0;font-size:.9rem;color:#555;}.wsp-hero a.wsp-btn-call{background:#E0A83C !important;border:2px solid #E0A83C !important;color:#16203A !important;font-size:1.25rem !important;font-weight:800 !important;padding:1rem 2.2rem !important;border-radius:40px !important;box-shadow:0 0 0 4px rgba(224,168,60,.25),0 8px 26px rgba(224,168,60,.5) !important;text-shadow:none !important;}.wsp-hero a.wsp-btn-call strong{color:#16203A !important;}.wsp-hero a.wsp-btn-call:hover{background:#fff !important;border-color:#fff !important;}</style><div class='wsp-hero'><div class='wsp-hero-inner'><div class='wsp-hero-left'><h1>Alabama Guides: Property Tax, Probate, Foreclosure and Selling by City and County</h1><div class=wsp-kicker>Cash Home Buyers in Alabama</div><div class=wsp-speed><span>Cash Offer in 24 Hours</span></div><ul class=wsp-checks><li>Alabama Guides: inherited, behind on payments, tenants or repairs, we buy the house as-is</li><li>No fees, commissions or closing costs on a Alabama Guides sale</li><li>Turn the Alabama Guides offer down and you owe us nothing</li></ul><h2>Sell Your Alabama House for Cash</h2><p>Tell us about your Alabama house.</p><p><a class='wsp-btn-outline wsp-btn-call' href='tel:424-435-2326'>Call or Text <strong>&nbsp;(424) 435-2326</strong></a></p></div><div class='wsp-hero-right'><iframe src='https://connect.cashhomebuyersca.com/widget/form/zKzKbSeB3aqwWwE8NNxO' data-form-id='zKzKbSeB3aqwWwE8NNxO' title='Cash Offer Form'></iframe><br /><script src='https://connect.cashhomebuyersca.com/js/form_embed.js' async></script></div></div></div><div class='wsp-wrap'><p><em>Last updated November 14, 2026.</em></p><div class=\"wsp-related\"><h3>Statewide guides</h3><p><a href