[{"slug": "north-dakota-guides-by-city-and-county", "title": "North Dakota Guides: Property Tax, Probate, Foreclosure and Selling by City and County", "content": "<!-- wp:html -->\n<style>.wsp-hero{position:relative;margin:0 calc(-50vw + 50%);padding:5rem 1.5rem;background-image:none;background:linear-gradient(170deg,#12293f 0%,#0c1c2e 46%,#060c16 100%);overflow:hidden;}.wsp-hero-inner{max-width:1216px;margin:0 auto;display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem;align-items:center;}.wsp-hero-left{text-align:center;}.wsp-hero-left h1{color:#fff;font-size:2.6rem;font-weight:800;line-height:1.15;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left h2{color:#fff;font-weight:300;font-size:1.3rem;margin:0 0 1rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-hero-left p{color:#fff;font-size:1rem;font-weight:300;max-width:500px;margin:0 auto 1.5rem;text-shadow:1px 1px 2px rgba(0,0,0,.3);}.wsp-btn-outline{display:inline-flex;align-items:center;border:2px solid #fff;border-radius:30px;padding:.6rem 1.4rem;font-weight:600;color:#fff;text-decoration:none;font-size:.95rem;}.wsp-btn-outline:hover{background:#fff;color:#1A202C;}.wsp-hero-right iframe{width:100%;min-height:560px;border:none;border-radius:4px;}.wsp-wrap{max-width:900px;margin:0 auto;padding:3rem 1.5rem 4rem;}@media (max-width:900px){.wsp-hero-inner{grid-template-columns:1fr;}.wsp-hero-left h1{font-size:2.1rem;}}.wsp-wrap h3{background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #3182CE;border-radius:8px;padding:.9rem 1.25rem;margin:1.75rem 0 0;font-size:1.05rem;font-weight:700;color:#1A202C;}.wsp-wrap h3+p{background:#fff;border:1px solid #e2e8f0;border-top:none;border-radius:0 0 8px 8px;padding:1rem 1.25rem;margin:0 0 .25rem;color:#444;}.wsp-wrap table td{vertical-align:top;}.chb-cta p{margin:0}.wsp-related{margin:2.5rem 0 1rem}.wsp-related h2{font-size:1.3rem;margin-bottom:1rem;font-weight:600;}.wsp-related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;}.wsp-related-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:1.1rem 1.25rem;}.wsp-related-card a{font-weight:700;color:var(--global-palette1, #3182CE);text-decoration:none;}.wsp-related-card a:hover{text-decoration:underline;}.wsp-related-card p{margin:.35rem 0 0;font-size:.9rem;color:#555;}.wsp-hero a.wsp-btn-call{background:#E0A83C !important;border:2px solid #E0A83C !important;color:#16203A !important;font-size:1.25rem !important;font-weight:800 !important;padding:1rem 2.2rem !important;border-radius:40px !important;box-shadow:0 0 0 4px rgba(224,168,60,.25),0 8px 26px rgba(224,168,60,.5) !important;text-shadow:none !important;}.wsp-hero a.wsp-btn-call strong{color:#16203A !important;}.wsp-hero a.wsp-btn-call:hover{background:#fff !important;border-color:#fff !important;}</style><div class='wsp-hero'><div class='wsp-hero-inner'><div class='wsp-hero-left'><h1>North Dakota Guides: Property Tax, Probate, Foreclosure and Selling by City and County</h1><div class=wsp-kicker>Cash Home Buyers in North Dakota</div><div class=wsp-speed><span>Cash Offer in 24 Hours</span></div><ul class=wsp-checks><li>North Dakota Guides: inherited, behind on payments, tenants or repairs, we buy the house as-is</li><li>No fees, commissions or closing costs on a North Dakota Guides sale</li><li>Turn the North Dakota Guides offer down and you owe us nothing</li></ul><h2>Sell Your North Dakota House for Cash</h2><p>Tell us about your North Dakota house.</p><p><a class='wsp-btn-outline wsp-btn-call' href='tel:424-435-2326'>Call or Text <strong>&nbsp;(424) 435-2326</strong></a></p></div><div class='wsp-hero-right'><iframe src='https://connect.cashhomebuyersca.com/widget/form/zKzKbSeB3aqwWwE8NNxO' data-form-id='zKzKbSeB3aqwWwE8NNxO' title='Cash Offer Form'></iframe><br /><script src='https://connect.cashhomebuyersca.com/js/form_embed.js' async></script></div></div></div><div class='wsp-wrap'><p><em>Last updated November 14, 2026.</em></p><div class=\"wsp-related\"><h3>Statewide guides</h3><p><a href=\"https://cashhomebuyersca.com/north-dakota-property-tax-guide/\">North Dakota Property Tax Guide: Appeals</a></p><h3>Sell my house by city</h3><p><a href=\"https://cashhomebuyersca.com/sell-my-house-fast-fargo-nd/\">Sell My House Fast in Fargo, ND</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-bismarck-nd/\">Sell My House Fast in Bismarck, ND</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-grand-forks-nd/\">Sell My House Fast in Grand Forks, ND</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-minot-nd/\">Sell My House Fast in Minot, ND</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-west-fargo-nd/\">Sell My House Fast in West Fargo, ND</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-williston-nd/\">Sell My House Fast in Williston, ND</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-dickinson-nd/\">Sell My House Fast in Dickinson, ND</a> <a href=\"https://cashhomebuyersca.com/sell-my-house-fast-mandan-nd/\">Sell My House Fast in Mandan, ND</a></p><h3>Property tax guides by city</h3><p><a href=\"https://cashhomebuyersca.com/fargo-nd-property-tax-guide/\">Fargo, ND Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/bismarck-nd-property-tax-guide/\">Bismarck, ND Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/grand-forks-nd-property-tax-guide/\">Grand Forks, ND Property Tax Guide</a></p><h3>Property tax guides by county</h3><p><a href=\"https://cashhomebuyersca.com/burleigh-county-nd-property-tax-guide/\">Burleigh County, ND Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/morton-county-nd-property-tax-guide/\">Morton County, ND Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/ward-county-nd-property-tax-guide/\">Ward County, ND Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/cass-county-nd-property-tax-guide/\">Cass County, ND Property Tax Guide</a> <a href=\"https://cashhomebuyersca.com/grand-forks-county-nd-property-tax-guide/\">Grand Forks County, ND Property Tax Guide</a></p></div>\n<div class=\"chb-cta\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;color:#fff;\"><div style=\"max-width:600px;\"><div style=\"font-size:12px;font-weight:800;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Selling in North Dakota?</div><div style=\"font-weight:800;font-size:20px;line-height:1.35;color:#fff;\">We buy North Dakota houses as-is, with no commission, no repairs and no closing costs to you.</div></div><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div></div>\n<!-- /wp:html --<div class='chb-rw'><h2>What should a seller know about North Dakota before reading the local guides?</h2><p>North Dakota is a large, thinly settled state, and that shapes almost every house sale in it. It covers 70,762 square miles, ranks 19th in area, and had an estimated population of 799,358 in 2025, which works out to about 10.7 people per square mile.</p>\n<p>The state entered the Union on November 2, 1889, with Bismarck as its capital and Fargo as its largest city. Cass County is the largest county. A seller in Fargo deals with a very different local market than a seller in a town of a few hundred people, but both follow the same state tax calendar, the same deed recording rules and the same landlord and eviction statutes.</p>\n<p>This directory page gives the state-level picture. The guides linked from this page go deeper on individual cities and counties.</p><h2>How is North Dakota laid out by region?</h2><p>The state divides into a handful of landforms, and each one tends to shape what a house is used for. The flat Red River Valley sits in the east on the bed of glacial Lake Agassiz, and its fertile soil supports a large agriculture industry. The central part is split between the Drift Prairie and the Missouri Plateau. The western half is hilly Great Plains with the northern part of the Badlands, west of the Missouri River.</p>\n<ul>\n<li>East: Fargo, West Fargo and Grand Forks sit along the Red River Valley side of the state, and Devils Lake, the largest natural lake in the state, is also in the east.</li>\n<li>Central: Bismarck and Mandan face each other across the Missouri River.</li>\n<li>North and northwest: Minot is the main city of Ward County, and Williston, in Williams County, is in the northwest where the Bakken development is centered.</li>\n<li>Southwest: Dickinson is the Stark County city on the state list.</li>\n</ul>\n<p>Oil extraction from the Bakken formation in the northwest has played a major role in the state economy into the 21st century, and the state links that development to population growth and lower unemployment.</p><h2>Which North Dakota cities and counties are the largest?</h2><p>The state Department of Commerce lists 13 communities with 5,000 or more residents based on 2021 population estimates, and 24 counties on its quick-facts page. Our local guides follow those larger places first.</p>\n<table>\n<thead><tr><th>Group</th><th>Places named by the Department of Commerce</th></tr></thead>\n<tbody>\n<tr><td>Cities of 5,000 or more (2021 estimates)</td><td>Fargo, Bismarck, Grand Forks, Minot, West Fargo, Williston, Dickinson, Mandan, Jamestown, Wahpeton, Devils Lake, Watford City, Valley City</td></tr>\n<tr><td>Larger counties on the same list</td><td>Cass, Burleigh, Ward, Grand Forks, Williams, Stark, Morton, Stutsman, Richland, Rolette, McKenzie, Ramsey</td></tr>\n<tr><td>Total counties in the state</td><td>53, according to the North Dakota Association of Counties</td></tr>\n</tbody>\n</table>\n<p>Every one of the 53 counties has its own auditor, treasurer and recorder, so a sale in Burleigh County runs through different offices than a sale in Cass County, even though the rules come from the same Century Code.</p><div class=\"chb-cta chb-cta-x\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:24px 28px;color:#fff;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;\"><span style=\"display:block;max-width:600px;font-weight:800;font-size:19px;line-height:1.35;color:#fff;\"><span style=\"display:block;font-size:12px;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Free, no-obligation offer</span>Tell us about your North Dakota house and get a written cash offer within 24 hours.</span><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div></div><h2>What does North Dakota weather mean for an older house?</h2><p>North Dakota has a continental climate with warm summers and cold winters, and the swing between the two is wide because the state sits far inland and roughly halfway between the equator and the North Pole. Sellers should expect buyers and inspectors to look closely at the furnace or boiler, insulation, windows, and the roof.</p>\n<p>For a cash sale, that matters because an as-is buyer takes the house with its heating system and roof as they stand, so the seller does not have to replace them before closing.</p><h2>How does property tax work across North Dakota?</h2><p>North Dakota counties determine and collect property tax on real property and then distribute the money to the county, cities, townships, school districts and other taxing districts. The state Tax Commissioner supervises the system and publishes the deadline calendar, but the bill you pay comes from your county treasurer.</p>\n<p>Real property is assessed as of February 1, and assessed value is 50 percent of market value. Tax is figured from three pieces: the mill rate, the taxable value and the taxing entity. The key dates for a homeowner are short.</p>\n<table>\n<thead><tr><th>Date</th><th>What happens</th></tr></thead>\n<tbody>\n<tr><td>January 1</td><td>Prior-year real estate tax is due</td></tr>\n<tr><td>February 1</td><td>Assessment date for real property</td></tr>\n<tr><td>February 15</td><td>Last day to pay in full for the 5 percent discount</td></tr>\n<tr><td>March 1</td><td>First installment due without penalty</td></tr>\n<tr><td>October 15</td><td>Second installment due without penalty</td></tr>\n<tr><td>November 1</td><td>Deadline to apply for abatement of the earlier year's taxes</td></tr>\n<tr><td>December 26</td><td>County treasurers mail the next statements</td></tr>\n</tbody>\n</table>\n<p>Our statewide property tax guide covers appeals, boards of equalization and the penalty schedule in more detail. If a date falls on a weekend or a state holiday, the Tax Commissioner says the action is not due until the next business day.</p><h2>What happens when property tax goes unpaid in North Dakota?</h2><p>Unpaid tax becomes a lien, and after enough time the county can foreclose that lien and take title by tax deed. Between November 1 and November 15 each year, the county treasurer mails a notice to each owner with delinquent land tax. It states that the tax is a lien and gives an October 1 deadline in the second year after the taxes became delinquent.</p>\n<ul>\n<li>The county auditor gives notice of foreclosure by June 1 for property where two or more years have passed since the tax came due.</li>\n<li>The foreclosure date is October 1 after the notice is served.</li>\n<li>After that date the auditor issues a tax deed to the county, which passes title free of most encumbrances.</li>\n<li>The county sells tax deed land at auction beginning the third Tuesday of November.</li>\n<li>If the sale brings in more than the amounts owed, the excess is held for 90 days so the record owner can claim it.</li>\n</ul>\n<p>A former owner, the owner's executor, or a parent, spouse or child can repurchase the property while the county still holds title. For an owner behind on tax, selling before the foreclosure date is usually the cleaner way out, because a sale can pay the lien from the proceeds.</p><div class=\"chb-cta chb-cta-x\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:24px 28px;color:#fff;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;\"><span style=\"display:block;max-width:600px;font-weight:800;font-size:19px;line-height:1.35;color:#fff;\"><span style=\"display:block;font-size:12px;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">Sell as-is</span>No repairs, no cleaning and no showings. We buy North Dakota houses in any condition.</span><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">See My Cash Offer &rarr;</a></div></div><h2>How are deeds recorded in North Dakota?</h2><p>A deed is recorded with the county recorder in the county where the land sits. The North Dakota Association of Counties describes recorders as keeping a record of each patent, deed, mortgage and bill of sale, and the recorder's fee schedule is set in N.D.C.C. 11-18-05.</p>\n<p>Fees are published locally. As one example, Burleigh County lists $20 for a document of one to six pages, $65 for seven to twenty-five pages and $3 for each additional page. The Century Code also directs the recorder not to record certain instruments unless they bear the auditor's certificate of transfer, so a closing agent checks with the auditor before the deed is filed.</p>\n<p>Because every county posts its own fees, the title company or closing attorney handling your sale will quote the actual recording cost for your county.</p><h2>Are there limits on who can buy farmland in North Dakota?</h2><p>Yes. Chapter 47-10.1 of the Century Code limits who may acquire agricultural land. A person who is not a United States citizen, a Canadian citizen or a permanent resident may not acquire an interest in agricultural land unless a narrow set of conditions is met, including living in the state at least ten months a year and a landholding of no more than 640 acres.</p>\n<p>The chapter also bars a foreign government from acquiring agricultural land after June 30, 2023, and a violation is a class A misdemeanor. Sellers of farmland, acreage or a house on a working farm should ask any buyer to confirm eligibility early, since a buyer who cannot qualify will not close.</p><h2>Which property tax credits can help a North Dakota homeowner?</h2><p>Three credits matter most to owner-occupants. The Primary Residence Credit gives up to $1,600 against the property tax due to an owner who lives in the home, with no age or income limits. The Homestead Property Tax Credit is for homeowners age 65 or older, or permanently and totally disabled, with income that does not exceed $70,000. The Disabled Veteran's Property Tax Credit reduces taxable value by up to $9,000 at a 100 percent disability rating.</p>\n<p>The Tax Commissioner lists April 1 as the deadline for the Primary Residence Credit and for homestead and disabled veteran applications filed with the local assessor. These credits attach to the person and the primary residence, so they do not help an investor who owns a rental or a vacant inherited house.</p></div><div class=\"chb-cta chb-cta-x\" style=\"margin:32px 0;border-radius:10px;background:linear-gradient(120deg,#0F1C2E 0%,#16293F 100%);padding:24px 28px;color:#fff;\"><div style=\"display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;\"><span style=\"display:block;max-width:600px;font-weight:800;font-size:19px;line-height:1.35;color:#fff;\"><span style=\"display:block;font-size:12px;letter-spacing:2px;color:#E0A83C;text-transform:uppercase;margin-bottom:6px;\">You pick the closing date</span>Close in as little as 7 days or on the date that works for you, with no fees or commissions.</span><a href=\"#\" onclick=\"var f=document.querySelector('iframe[data-form-id]');if(f){f.scrollIntoView({behavior:'smooth',block:'center'});return false;}\" style=\"flex-shrink:0;padding:14px 24px;border-radius:8px;background:#E0A83C;color:#16203A;font-size:14px;font-weight:800;text-decoration:none;white-space:nowrap;\">Get My Cash Offer &rarr;</a></div></div><h2>Frequently asked questions</h2><h3 class=\"wp-block-heading\">Does North Dakota have a statewide property tax?</h3><p>North Dakota property tax is set and collected locally. Counties determine and collect the tax and pass it on to cities, townships, school districts and other taxing districts. The state Tax Commissioner publishes the calendar and supervises assessment.</p><h3 class=\"wp-block-heading\">When are North Dakota property taxes due?</h3><p>Real estate tax is due January 1 and can be paid without penalty until March 1, or in two installments with the second due October 15. Paying in full by February 15 earns a 5 percent discount.</p><h3 class=\"wp-block-heading\">How many counties does North Dakota have?</h3><p>North Dakota has 53 counties, and each has its own recorder who files deeds for land in that county.</p><h3 class=\"wp-block-heading\">What happens if I do not pay property tax in North Dakota?</h3><p>The tax becomes a lien. After two or more years of delinquency the county auditor can foreclose the lien and issue a tax deed to the county, and the county later sells the property at auction.</p><h3 class=\"wp-block-heading\">Can I sell a North Dakota house with unpaid property tax?</h3><p>Yes. Delinquent tax is paid from the sale proceeds at closing, and payments are applied to the oldest unpaid tax first. A buyer who pays cash can close quickly enough to stop a foreclosure date from arriving.</p><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"Does North Dakota have a statewide property tax?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"North Dakota property tax is set and collected locally. Counties determine and collect the tax and pass it on to cities, townships, school districts and other taxing districts. The state Tax Commissioner publishes the calendar and supervises assessment.\"}}, {\"@type\": \"Question\", \"name\": \"When are North Dakota property taxes due?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Real estate tax is due January 1 and can be paid without penalty until March 1, or in two installments with the second due October 15. Paying in full by February 15 earns a 5 percent discount.\"}}, {\"@type\": \"Question\", \"name\": \"How many counties does North Dakota have?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"North Dakota has 53 counties, and each has its own recorder who files deeds for land in that county.\"}}, {\"@type\": \"Question\", \"name\": \"What happens if I do not pay property tax in North Dakota?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"The tax becomes a lien. After two or more years of delinquency the county auditor can foreclose the lien and issue a tax deed to the county, and the county later sells the property at auction.\"}}, {\"@type\": \"Question\", \"name\": \"Can I sell a North Dakota house with unpaid property tax?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Yes. Delinquent tax is paid from the sale proceeds at closing, and payments are applied to the oldest unpaid tax first. A buyer who pays cash can close quickly enough to stop a foreclosure date from arriving.\"}}]}</script>>", "status": "publish", "rank_math_title": "North Dakota Guides by City and County | Cash Home Buyers", "rank_math_description": "Every North Dakota guide in one place: property tax, probate, foreclosure and selling a house, by statewide topic, city and county. Official sources.", "rank_math_focus_keyword": "north dakota property guides"}]